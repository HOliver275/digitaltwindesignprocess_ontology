    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Artefact</IRI>
        <Literal xml:lang="en">An identifiable work involved in some stage or activity of the development process that:
- is disseminated or delivered as one of the intermediate or finalized results of the process; and/or
-is input into some part of the development process as an object to be analyzed, developed or tested; and
-is not merely a transitory work or information scrap that is revised, discarded or abandoned throughout the process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CAE_VirtualTesting</IRI>
        <Literal xml:lang="en">Computer-Aided Engineering (CAE) virtual testing</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Component</IRI>
        <Literal xml:lang="en">A part of some whole. Could be a code module of the software which itself is a component of the DigitalTwin; or could be a part of the PhysicalAsset.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConceptDevelopment</IRI>
        <Literal xml:lang="en">The concept development stage of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ConceptDevelopment_FlowD</IRI>
        <Literal xml:lang="en">Design progressively released</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ConceptDevelopment_FlowE</IRI>
        <Literal xml:lang="en">Parts progressively incorporated</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Continuity</IRI>
        <Literal xml:lang="en">A Continuity consists of a sequence of one or more Spans, that link two or more DevelopmentActivities, across two or more TemporalPartitions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Datapoint</IRI>
        <Literal xml:lang="en">A Datapoint is a single value of one particular type.

Units must be defined using the hasUnit data property.

A range of acceptable values can be defined using minTargetValue and maxTargetValue.

The previous value can be stored using prevValue.

To continuously track the changing value of the same Datapoint, you can do so programmatically using a database or flat file outside of the ontology.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Dataset</IRI>
        <Literal xml:lang="en">One or more links to a dataset that is a Parameter to the development process. 

A Dataset may include one or more Documents.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Deliverable</IRI>
        <Literal xml:lang="en">A deliverable Artefact of some stage or activity of the development process, that isn&apos;t necessarily a Product or a Twin. A deliverable could be a report, a prototype, a model, and so on.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DesignActivity</IRI>
        <Literal xml:lang="en">A DevelopmentActivity, or composition of DevelopmentActivities, that is primarily focussed on design.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DesignInput</IRI>
        <Literal xml:lang="en">Input into some DesignActivity, or primarily design-related input into some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DesignOutput</IRI>
        <Literal xml:lang="en">Output from some DesignActivity, or primarily design-related output from some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DetailDesign</IRI>
        <Literal xml:lang="en">The detail design stage of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DevelopmentActivity</IRI>
        <Literal xml:lang="en">A type of activity undertaken during the design process. 

A DevelopmentActivity can be composed of multiple smaller DevelopmentActivities. Thus it is possible to instantiate a DesignActivity that consists of multiple smaller DesignActivities, but also some TestingActivities, Procurement, and so on.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DigitalTwin</IRI>
        <Literal xml:lang="en">The digital part of the Twin that is being developed throughout the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Document</IRI>
        <Literal xml:lang="en">A single link to a document that is a Parameter to the development process.

A Document can be part of a Dataset.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EngineeringDesign</IRI>
        <Literal xml:lang="en">A DesignActivity, or composition of DesignActivities, that is primarily focussed on engineering design.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow</IRI>
        <Literal xml:lang="en">A Flow is an ordered list of one or more Steps from one DevelopmentActivity to another, during one TemporalPartition of the development process. 

Flows that occur more than once during the development process can be defined as subclasses. The existing subclasses are not exhaustive.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_CAE_VirtualTesting_PhysicalTesting</IRI>
        <Literal xml:lang="en">A flow that steps from CAE/virtual testing to performance testing to mechanical testing.

The CAE/virtual testing may be conducted in parallel with the physical testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_CAE_VirtualTesting_Procurement</IRI>
        <Literal xml:lang="en">A flow that steps from CAE/virtual testing to procurement.

During this Flow, specifications may be sent to suppliers.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_DesignActivity_CAE_VirtualTesting</IRI>
        <Literal xml:lang="en">A flow that steps from design activity to CAE/virtual testing and back again.

Often takes the form of a Loop.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Flow_DesignActivity_CAE_VirtualTesting</IRI>
        <Literal xml:lang="en">Design and analysis using CAE simulation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_DesignActivity_Procurement</IRI>
        <Literal xml:lang="en">A flow that steps from design activity to procurement.

This release process occurs progressively with a view to ensuring that suppliers of test prototypes are working with design information which is up-to-date but do not need to wait until the respective design activity is finalised.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Flow_DesignActivity_Procurement</IRI>
        <Literal xml:lang="en">Design progressively released.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_PhysicalTesting_VirtualTesting_DesignActivity</IRI>
        <Literal xml:lang="en">A Flow that steps from physical (mechanical and performance) and virtual testing to design activity.

Each procured prototype can involve a mix of old and new parts depending on the project progress. Performance testing starts slightly before mechanical testing and runs almost in parallel. Any design issues identified through these physical tests are dealt with in the next stage of the process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Flow_PhysicalTesting_VirtualTesting_DesignActivity</IRI>
        <Literal xml:lang="en">Parts progressively incorporated.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow_Procurement_PhysicalTesting</IRI>
        <Literal xml:lang="en">A Flow that steps from procurement to physical (performance and mechanical) testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Focus</IRI>
        <Literal xml:lang="en">What you focus on during an activity, or time period, or in relation to something.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Gateway</IRI>
        <Literal xml:lang="en">In a stage-gate process, a Gateway closes one ProductDevelopmentStage and opens another, given that certain conditions are met.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Input</IRI>
        <Literal xml:lang="en">An Input consists of the things that are necessary in order to begin a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact. Supposing we have a Twin as the Output from one DevelopmentActivity. In order to continue developing the Twin during the next DevelopmentActivity, it will have to be passed in as part of the Input to that DevelopmentActivity.

An item of information, such as a Datapoint, may also form part of the Input. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Iteration</IRI>
        <Literal xml:lang="en">An Iteration groups DevelopmentActivities that are carried out together in cycles that may be repeated. 

Iterations that occur more than once during the development process may be defined as subclasses. The existing subclasses are not exhaustive.

The DevelopmentActivities in an Iteration are not assumed to be carried out in sequence or in any particular order.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Iteration_CAE_VirtualTesting_EngineeringDesign</IRI>
        <Literal xml:lang="en">An Iteration that includes CAE/virtual testing and engineering design.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting</IRI>
        <Literal xml:lang="en">An Iteration that includes CAE/virtual testing, engineering design, and performance testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting_MechanicalTesting</IRI>
        <Literal xml:lang="en">An Iteration that includes CAE/virtual testing, engineering design, mechanical testing, and performance testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting</IRI>
        <Literal>An Iteration that involves CAE/virtual testing, mechanical testing, and performance testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Loop</IRI>
        <Literal xml:lang="en">A Loop is a Flow that may be repeated. 

Unlike an Iteration which is not necessarily ordered, a Loop has an ordered sequence of Steps.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#MechanicalTestingSpan3</IRI>
        <Literal xml:lang="en">Verified and validated</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Model</IRI>
        <Literal xml:lang="en">A Model is a representation of something that exists in reality. An architectural model can be a physical or digital representation of a building. An information model is a digital representation of some knowledge domain (this ontology is an information model).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Modelling</IRI>
        <Literal xml:lang="en">A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on modelling.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ModellingAndSimulation</IRI>
        <Literal xml:lang="en">A DevelopmentActivity that consists of modelling and/or simulation, or a composition of DevelopmentActivities, that is primarily focussed on modelling and/or simulation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Output</IRI>
        <Literal xml:lang="en">&quot;An Output consists of the things that are produced or changed during a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact that is developed during some DevelopmentActivity. It is then part of the Output from that DevelopmentActivity, and will most likely form part of the Input to another DevelopmentActivity. 

An item of information, such as a Datapoint, may also form part of an Output. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity.&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Parameter</IRI>
        <Literal xml:lang="en">A Parameter is an item of information that forms part of the Input to, or Output from, some DevelopmentActivity or TemporalConstruct in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PhysicalAsset</IRI>
        <Literal xml:lang="en">The physical part of the product being developed throughout the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PhysicalModel</IRI>
        <Literal xml:lang="en">A physical model will not fit in an ontology, so must be accompanied by at least one text description.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PhysicalTesting</IRI>
        <Literal xml:lang="en">Testing of objects in the physical world.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Procurement</IRI>
        <Literal xml:lang="en">A DevelopmentActivity, or composition of DevelopmentActivities, that primarily involves procurement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Product</IRI>
        <Literal xml:lang="en">The thing that is produced - and may or may not be sold, depending on the context - as the culmination of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ProductDevelopmentStage</IRI>
        <Literal xml:lang="en">In this ontology, we assume that a ProductDevelopmentStage is part of a stage-gate process, but the ontology should be extensible to accommodate other development process models.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ProgressiveRelease</IRI>
        <Literal xml:lang="en">A ReleaseActivity that is carried out progressively over some TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ReleaseActivity</IRI>
        <Literal xml:lang="en">A DevelopmentActivity, or composition of DevelopmentActivities, that relates mainly to the release of some deliverable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Simulation</IRI>
        <Literal xml:lang="en">A simulation of some real-world object or process; or, the output from a SimulationActivity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SimulationActivity</IRI>
        <Literal xml:lang="en">A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on simulation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Span</IRI>
        <Literal xml:lang="en">A Span links two DevelopmentActivities across one or more TemporalPartitions.

Spans can be sequentially linked, using the followsFrom and leadsTo properties, to form a Continuity across TemporalPartitions of the development process.

A Span differs from a Step in that a Span is part of a Continuity, which begins and ends in two different TemporalPartitions. Therefore the TemporalPartitions of a Span must be specified as part of the Span&apos;s definition.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stage1</IRI>
        <Literal xml:lang="en">Requirement analysis and planning</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stage2</IRI>
        <Literal xml:lang="en">Concept development and demonstration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stage3</IRI>
        <Literal xml:lang="en">System-level design and verification</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stage4</IRI>
        <Literal xml:lang="en">Detail design and validation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stage5</IRI>
        <Literal xml:lang="en">Production release</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step</IRI>
        <Literal xml:lang="en">A Step connects one DevelopmentActivity to another.

Steps can be sequentially linked, using the hasPrevious and hasNext properties, to form a Flow.

A Step forms part of a Flow, which takes place within exactly one TemporalPartition. A Step differs from a Span in that the DevelopmentActivities connected by a Step always begin in the same TemporalPartition. The TemporalPartition is the same as the one specified in the Flow, so does not have to be specified at each Step of the Flow.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_CAE_VirtualTestingToDesignActivity</IRI>
        <Literal xml:lang="en">A Step from CAE/virtual testing to design activity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_CAE_VirtualTestingToPerformanceTesting</IRI>
        <Literal xml:lang="en">A Step from CAE/virtual testing to performance testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_CAE_VirtualTestingToProcurement</IRI>
        <Literal xml:lang="en">A Step from CAE/virtual testing to procurement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_DesignActivityToCAE_VirtualTesting</IRI>
        <Literal>A Step from design activity to CAE/virtual testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_DesignActivityToProcurement</IRI>
        <Literal>A Step from design activity to procurement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_MechanicalTestingToCAE_VirtualTesting</IRI>
        <Literal xml:lang="en">A Step from mechanical testing to CAE/virtual testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_PerformanceTestingToDesignActivity</IRI>
        <Literal xml:lang="en">A Step from performance testing to design activity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_PerformanceTestingToMechanicalTesting</IRI>
        <Literal xml:lang="en">A Step from performance testing to mechanical testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_ProcurementToMechanicalTesting</IRI>
        <Literal xml:lang="en">A Step from procurement to mechanical testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Step_ProcurementToPerformanceTesting</IRI>
        <Literal xml:lang="en">A Step from procurement to performance testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SystemLevelDesign</IRI>
        <Literal xml:lang="en">The system-level design stage of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SystemLevelDesign_FlowD</IRI>
        <Literal xml:lang="en">Design progressively released</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SystemLevelDesign_FlowE</IRI>
        <Literal xml:lang="en">Parts progressively incorporated</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TemporalConstruct</IRI>
        <Literal xml:lang="en">A TemporalConstruct is a way of representing time in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TemporalPartition</IRI>
        <Literal xml:lang="en">A TemporalPartition represents some distinct time period in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TestingActivity</IRI>
        <Literal xml:lang="en">A DevelopmentActivity, or a composition of DevelopmentActivities, that relates primarily to testing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TestingFocus</IRI>
        <Literal xml:lang="en">What the testing is focussed on at some point in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus1</IRI>
        <Literal xml:lang="en">Is technology viable?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus10</IRI>
        <Literal xml:lang="en">Is production-tooled design reliable under use conditions?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus11</IRI>
        <Literal xml:lang="en">Have any outstanding issues been worked out?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus12</IRI>
        <Literal xml:lang="en">Physical tests for final validation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus2</IRI>
        <Literal xml:lang="en">Emphasis on CAE analysis and virtual testing</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus3</IRI>
        <Literal xml:lang="en">Is concept viable?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus4</IRI>
        <Literal xml:lang="en">Are there problems of manufacturability, maintainability, etc?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus5</IRI>
        <Literal xml:lang="en">Physical prototypes use many parts from existing designs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus6</IRI>
        <Literal xml:lang="en">Test against customer requirements, including in customer machines</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus7</IRI>
        <Literal xml:lang="en">Does design meet specification under conditions of use?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus8</IRI>
        <Literal xml:lang="en">Are regulatory requirements met?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TestingFocus9</IRI>
        <Literal xml:lang="en">New parts are progressively installed in prototypes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TestingInput</IRI>
        <Literal xml:lang="en">Input into some TestingActivity, or primarily testing-related input into some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TestingOutput</IRI>
        <Literal xml:lang="en">Output from some TestingActivity, or primarily testing-related output from some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Twin</IRI>
        <Literal xml:lang="en">A Twin is that which is being developed at every stage, and during every activity, of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#VirtualTesting</IRI>
        <Literal xml:lang="en">Testing that is carried out on data objects, rather than on physical objects.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#closedByGateway</IRI>
        <Literal xml:lang="en">In a stage-gate development process, a ProductDevelopmentStage is closed by a Gateway, provided certain conditions are met.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#closesStage</IRI>
        <Literal xml:lang="en">A Gateway closes a ProductDevelopmentStage in a stage-gate development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#comesAfter</IRI>
        <Literal xml:lang="en">Anything that must be preceded by some other thing or things at some point in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#comesBefore</IRI>
        <Literal xml:lang="en">Anything that must precede some other thing or things at some point in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#continuityFrom</IRI>
        <Literal xml:lang="en">The TemporalPartition where a Continuity begins.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#continuityTo</IRI>
        <Literal xml:lang="en">The TemporalPartition where a Continuity ends.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#createdOn</IRI>
        <Literal xml:lang="en">Date/time stamp recording when an entity was created.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#duringTemporalPartition</IRI>
        <Literal xml:lang="en">A DevelopmentActivity, or a TemporalConstruct that is not itself a TemporalPartition, takes place during a TemporalPartition in the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#endsWith</IRI>
        <Literal xml:lang="en">The DevelopmentActivity or TemporalConstruct at the end of a TimeStructure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#followsFrom</IRI>
        <Literal xml:lang="en">One DevelopmentActivity or TemporalConstruct leads to another, sometimes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasArtefact</IRI>
        <Literal xml:lang="en">Artefact associated with a DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasComponent</IRI>
        <Literal xml:lang="en">Component associated with a DevelopmentActivity or TemporalConstruct or Input or Output</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasDeliverable</IRI>
        <Literal xml:lang="en">The Deliverable of some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasDevelopmentActivity</IRI>
        <Literal xml:lang="en">The DevelopmentActivity associated with some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasDigitalTwin</IRI>
        <Literal xml:lang="en">A PhysicalAsset has a DigitalTwin. To associate the DigitalTwin with some other entity, use hasArtefact.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasFocus</IRI>
        <Literal>The focus of some aspect of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasInput</IRI>
        <Literal xml:lang="en">Input into some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasModel</IRI>
        <Literal xml:lang="en">Model associated with an entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasOutput</IRI>
        <Literal xml:lang="en">Output from some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasParameter</IRI>
        <Literal xml:lang="en">An input or output Parameter.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasPhysicalAsset</IRI>
        <Literal xml:lang="en">A DigitalTwin is twinned with a PhysicalAsset. To associate the PhysicalAsset with some other entity, use hasArtefact.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasProduct</IRI>
        <Literal xml:lang="en">The product of some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasURI</IRI>
        <Literal xml:lang="en">URI associated with some entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasUnit</IRI>
        <Literal xml:lang="en">The unit in which some measurement is expressed.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasValue</IRI>
        <Literal xml:lang="en">Value of some Datapoint. Can be any datatype.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inputInto</IRI>
        <Literal xml:lang="en">Input into some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isArtefactOf</IRI>
        <Literal xml:lang="en">Artefact of some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isComponentOf</IRI>
        <Literal xml:lang="en">Component associated with a DevelopmentActivity or TemporalConstruct or Input or Output</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isDeliverableOf</IRI>
        <Literal xml:lang="en">The Deliverable of some DevelopmentActivity or TemporalConstruct.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isDevelopmentActivityOf</IRI>
        <Literal xml:lang="en">DevelopmentActivity associated with some part of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isDigitalTwinOf</IRI>
        <Literal xml:lang="en">A DigitalTwin is twinned with a PhysicalAsset. To associate the DigitalTwin with some other entity, use isArtefactOf.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isEndOf</IRI>
        <Literal xml:lang="en">The DevelopmentActivity or TemporalConstruct at the end of a TimeStructure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isFocusOf</IRI>
        <Literal xml:lang="en">The focus of some aspect of the development process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isFollowedBy</IRI>
        <Literal xml:lang="en">One DevelopmentActivity or TemporalConstruct leads to another, sometimes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isLedToBy</IRI>
        <Literal xml:lang="en">One DevelopmentActivity or TemporalConstruct leads to another, sometimes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isModelOf</IRI>
        <Literal xml:lang="en">Entity associated with a Model.</Literal>
    </AnnotationAssertion>
