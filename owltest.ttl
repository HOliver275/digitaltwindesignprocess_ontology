#    Data properties
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#createdOn
figure8secondattempt:createdOn rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:dateTimeStamp ;
                               rdfs:comment "Date/time stamp recording when an entity was created."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#expectedValue
figure8secondattempt:expectedValue rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDescription
figure8secondattempt:hasDescription rdf:type owl:DatatypeProperty ;
                                    rdfs:range xsd:string .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasURI
figure8secondattempt:hasURI rdf:type owl:DatatypeProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( figure8secondattempt:Dataset
                                                        figure8secondattempt:Document
                                                        figure8secondattempt:Model
                                                      )
                                        ] ;
                            rdfs:range xsd:anyURI ;
                            rdfs:comment "URI associated with some entity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasUnit
figure8secondattempt:hasUnit rdf:type owl:DatatypeProperty ;
                             rdfs:domain figure8secondattempt:Datapoint ;
                             rdfs:range xsd:string ;
                             rdfs:comment "The unit in which some measurement is expressed."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isOptional
figure8secondattempt:isOptional rdf:type owl:DatatypeProperty ;
                                rdfs:domain figure8secondattempt:Step ;
                                rdfs:range xsd:boolean ;
                                rdfs:comment "Flags whether a Step is optional."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isRepeated
figure8secondattempt:isRepeated rdf:type owl:DatatypeProperty ;
                                rdfs:domain figure8secondattempt:Iteration ;
                                rdfs:range xsd:boolean .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#maxTargetValue
figure8secondattempt:maxTargetValue rdf:type owl:DatatypeProperty ;
                                    rdfs:domain figure8secondattempt:Datapoint ;
                                    rdfs:comment "Maximum target value of a Datapoint. Can be any data type."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValue
figure8secondattempt:measuredValue rdf:type owl:DatatypeProperty ;
                                   rdfs:domain figure8secondattempt:Datapoint ;
                                   rdfs:comment "Measured value of some Datapoint. Can be any datatype."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValuePhysical
figure8secondattempt:measuredValuePhysical rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf figure8secondattempt:measuredValue ;
                                           owl:propertyDisjointWith figure8secondattempt:measuredValueVirtual .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValueVirtual
figure8secondattempt:measuredValueVirtual rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf figure8secondattempt:measuredValue .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minTargetValue
figure8secondattempt:minTargetValue rdf:type owl:DatatypeProperty ;
                                    rdfs:domain figure8secondattempt:Datapoint ;
                                    rdfs:comment "Minimum target value of a Datapoint. Can be any data type." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue
figure8secondattempt:prevMeasuredValue rdf:type owl:DatatypeProperty ;
                                       rdfs:domain figure8secondattempt:Datapoint ;
                                       rdfs:comment "Previous value of a Datapoint. Can be any data type."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValuePhysical
figure8secondattempt:prevMeasuredValuePhysical rdf:type owl:DatatypeProperty ;
                                               rdfs:subPropertyOf figure8secondattempt:prevMeasuredValue ;
                                               owl:propertyDisjointWith figure8secondattempt:prevMeasuredValueVirtual .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValueVirtual
figure8secondattempt:prevMeasuredValueVirtual rdf:type owl:DatatypeProperty ;
                                              rdfs:subPropertyOf figure8secondattempt:prevMeasuredValue .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#updatedOn
figure8secondattempt:updatedOn rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:dateTimeStamp ;
                               rdfs:comment "Date/time stamp recording when an entity was updated."@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact
figure8secondattempt:Artefact rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Artefact
                                                                         [ rdf:type owl:Class ;
                                                                           owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty figure8secondattempt:hasArtefact ;
                                                                                           owl:someValuesFrom figure8secondattempt:Artefact
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty figure8secondattempt:hasComponent ;
                                                                                           owl:someValuesFrom figure8secondattempt:Component
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty figure8secondattempt:hasParameter ;
                                                                                           owl:someValuesFrom figure8secondattempt:Parameter
                                                                                         ]
                                                                                       )
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              owl:disjointWith figure8secondattempt:DevelopmentActivity ,
                                               figure8secondattempt:Environment ,
                                               figure8secondattempt:Flow ,
                                               figure8secondattempt:Focus ,
                                               figure8secondattempt:Iteration ,
                                               figure8secondattempt:Parameter ,
                                               figure8secondattempt:Step ,
                                               figure8secondattempt:TemporalConstruct ;
                              rdfs:comment """An identifiable work involved in some stage or activity of the development process that:
- is disseminated or delivered as one of the intermediate or finalized results of the process; and/or
-is input into some part of the development process as an object to be analyzed, developed or tested; and
-is not merely a transitory work or information scrap that is revised, discarded or abandoned throughout the process."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CADModel
figure8secondattempt:CADModel rdf:type owl:Class ;
                              rdfs:subClassOf figure8secondattempt:VirtualModel .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting
figure8secondattempt:CAE_VirtualTesting rdf:type owl:Class ;
                                        rdfs:subClassOf figure8secondattempt:VirtualTesting ;
                                        rdfs:comment "Computer-Aided Engineering (CAE) virtual testing"@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component
figure8secondattempt:Component rdf:type owl:Class ;
                               owl:disjointWith figure8secondattempt:DevelopmentActivity ,
                                                figure8secondattempt:Environment ,
                                                figure8secondattempt:Focus ,
                                                figure8secondattempt:TemporalConstruct ;
                               rdfs:comment "A part of some whole. Could be a code module of the software which itself is a component of the DigitalTwin; or could be a part of the PhysicalAsset."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ConceptDevelopment
figure8secondattempt:ConceptDevelopment rdf:type owl:Class ;
                                        rdfs:subClassOf figure8secondattempt:ProductDevelopmentStage ;
                                        owl:disjointWith figure8secondattempt:DetailDesign ,
                                                         figure8secondattempt:SystemLevelDesign ;
                                        rdfs:comment "The concept development stage of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity
figure8secondattempt:Continuity rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Continuity
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:hasSpan ;
                                                                             owl:someValuesFrom figure8secondattempt:Span
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:duringTemporalPartition ;
                                                                             owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                             owl:onClass figure8secondattempt:TemporalPartition
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:continuityFrom ;
                                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                             owl:onClass figure8secondattempt:TemporalPartition
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:continuityTo ;
                                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                             owl:onClass figure8secondattempt:TemporalPartition
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:endsWith ;
                                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                             owl:onClass figure8secondattempt:Span
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:startsWith ;
                                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                             owl:onClass figure8secondattempt:Span
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf figure8secondattempt:TimeStructure ;
                                owl:disjointWith figure8secondattempt:Flow ,
                                                 figure8secondattempt:Iteration ,
                                                 figure8secondattempt:Span ,
                                                 figure8secondattempt:Step ;
                                rdfs:comment "A Continuity consists of a sequence of one or more Spans, that link two or more DevelopmentActivities, across two or more TemporalPartitions."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint
figure8secondattempt:Datapoint rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Datapoint
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:createdOn ;
                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange xsd:dateTimeStamp
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:expectedValue ;
                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                                              owl:unionOf ( rdf:PlainLiteral
                                                                                                            rdf:XMLLiteral
                                                                                                            rdf:langString
                                                                                                            rdfs:Literal
                                                                                                            xsd:NCName
                                                                                                            xsd:NMTOKEN
                                                                                                            xsd:Name
                                                                                                            xsd:anyURI
                                                                                                            xsd:base64Binary
                                                                                                            xsd:boolean
                                                                                                            xsd:byte
                                                                                                            xsd:dateTime
                                                                                                            xsd:dateTimeStamp
                                                                                                            xsd:decimal
                                                                                                            xsd:double
                                                                                                            xsd:float
                                                                                                            xsd:hexBinary
                                                                                                            xsd:int
                                                                                                            xsd:integer
                                                                                                            xsd:language
                                                                                                            xsd:long
                                                                                                            xsd:negativeInteger
                                                                                                            xsd:nonNegativeInteger
                                                                                                            xsd:nonPositiveInteger
                                                                                                            xsd:normalizedString
                                                                                                            xsd:positiveInteger
                                                                                                            xsd:short
                                                                                                            xsd:token
                                                                                                            xsd:unsignedByte
                                                                                                            xsd:unsignedInt
                                                                                                            xsd:unsignedLong
                                                                                                            xsd:unsignedShort
                                                                                                            owl:rational
                                                                                                            owl:real
                                                                                                          )
                                                                                            ]
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:hasUnit ;
                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange xsd:string
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:maxTargetValue ;
                                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                                              owl:unionOf ( rdf:PlainLiteral
                                                                                                            rdf:XMLLiteral
                                                                                                            rdf:langString
                                                                                                            rdfs:Literal
                                                                                                            xsd:NCName
                                                                                                            xsd:NMTOKEN
                                                                                                            xsd:Name
                                                                                                            xsd:anyURI
                                                                                                            xsd:base64Binary
                                                                                                            xsd:boolean
                                                                                                            xsd:byte
                                                                                                            xsd:dateTime
                                                                                                            xsd:dateTimeStamp
                                                                                                            xsd:decimal
                                                                                                            xsd:double
                                                                                                            xsd:float
                                                                                                            xsd:hexBinary
                                                                                                            xsd:int
                                                                                                            xsd:integer
                                                                                                            xsd:language
                                                                                                            xsd:long
                                                                                                            xsd:negativeInteger
                                                                                                            xsd:nonNegativeInteger
                                                                                                            xsd:nonPositiveInteger
                                                                                                            xsd:normalizedString
                                                                                                            xsd:positiveInteger
                                                                                                            xsd:short
                                                                                                            xsd:token
                                                                                                            xsd:unsignedByte
                                                                                                            xsd:unsignedInt
                                                                                                            xsd:unsignedLong
                                                                                                            xsd:unsignedShort
                                                                                                            owl:rational
                                                                                                            owl:real
                                                                                                          )
                                                                                            ]
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:measuredValue ;
                                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                                              owl:unionOf ( rdf:PlainLiteral
                                                                                                            rdf:XMLLiteral
                                                                                                            rdf:langString
                                                                                                            rdfs:Literal
                                                                                                            xsd:NCName
                                                                                                            xsd:NMTOKEN
                                                                                                            xsd:Name
                                                                                                            xsd:anyURI
                                                                                                            xsd:base64Binary
                                                                                                            xsd:boolean
                                                                                                            xsd:byte
                                                                                                            xsd:dateTime
                                                                                                            xsd:dateTimeStamp
                                                                                                            xsd:decimal
                                                                                                            xsd:double
                                                                                                            xsd:float
                                                                                                            xsd:hexBinary
                                                                                                            xsd:int
                                                                                                            xsd:integer
                                                                                                            xsd:language
                                                                                                            xsd:long
                                                                                                            xsd:negativeInteger
                                                                                                            xsd:nonNegativeInteger
                                                                                                            xsd:nonPositiveInteger
                                                                                                            xsd:normalizedString
                                                                                                            xsd:positiveInteger
                                                                                                            xsd:short
                                                                                                            xsd:token
                                                                                                            xsd:unsignedByte
                                                                                                            xsd:unsignedInt
                                                                                                            xsd:unsignedLong
                                                                                                            xsd:unsignedShort
                                                                                                            owl:rational
                                                                                                            owl:real
                                                                                                          )
                                                                                            ]
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:minTargetValue ;
                                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                            owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                                              owl:unionOf ( rdf:PlainLiteral
                                                                                                            rdf:XMLLiteral
                                                                                                            rdf:langString
                                                                                                            rdfs:Literal
                                                                                                            xsd:NCName
                                                                                                            xsd:NMTOKEN
                                                                                                            xsd:Name
                                                                                                            xsd:anyURI
                                                                                                            xsd:base64Binary
                                                                                                            xsd:boolean
                                                                                                            xsd:byte
                                                                                                            xsd:dateTime
                                                                                                            xsd:dateTimeStamp
                                                                                                            xsd:decimal
                                                                                                            xsd:double
                                                                                                            xsd:float
                                                                                                            xsd:hexBinary
                                                                                                            xsd:int
                                                                                                            xsd:integer
                                                                                                            xsd:language
                                                                                                            xsd:long
                                                                                                            xsd:negativeInteger
                                                                                                            xsd:nonNegativeInteger
