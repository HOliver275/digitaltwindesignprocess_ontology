                                                                                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                        owl:unionOf ( figure8secondattempt:CAE_VirtualTesting
                                                                                                                                                                      figure8secondattempt:EngineeringDesign
                                                                                                                                                                      figure8secondattempt:PerformanceTesting
                                                                                                                                                                    )
                                                                                                                                                      ]
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:EngineeringDesign
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:PerformanceTesting
                                                                                                                                  ]
                                                                                                                                ) ;
                                                                                                             rdf:type owl:Class
                                                                                                           ] ;
                                                                                       rdfs:subClassOf figure8secondattempt:Iteration ;
                                                                                       rdfs:comment "An Iteration that includes CAE/virtual testing, engineering design, and performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting_MechanicalTesting
figure8secondattempt:Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting_MechanicalTesting rdf:type owl:Class ;
                                                                                                         owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Iteration
                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                      owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                                      owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                                          owl:unionOf ( figure8secondattempt:CAE_VirtualTesting
                                                                                                                                                                                        figure8secondattempt:EngineeringDesign
                                                                                                                                                                                        figure8secondattempt:MechanicalTesting
                                                                                                                                                                                        figure8secondattempt:PerformanceTesting
                                                                                                                                                                                      )
                                                                                                                                                                        ]
                                                                                                                                                    ]
                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                      owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                      owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                                                                    ]
                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                      owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                      owl:onClass figure8secondattempt:EngineeringDesign
                                                                                                                                                    ]
                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                      owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                      owl:onClass figure8secondattempt:MechanicalTesting
                                                                                                                                                    ]
                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                      owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                      owl:onClass figure8secondattempt:PerformanceTesting
                                                                                                                                                    ]
                                                                                                                                                  ) ;
                                                                                                                               rdf:type owl:Class
                                                                                                                             ] ;
                                                                                                         rdfs:subClassOf figure8secondattempt:Iteration ;
                                                                                                         rdfs:comment "An Iteration that includes CAE/virtual testing, engineering design, mechanical testing, and performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting
figure8secondattempt:Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting rdf:type owl:Class ;
                                                                                       owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Iteration
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                        owl:unionOf ( figure8secondattempt:CAE_VirtualTesting
                                                                                                                                                                      figure8secondattempt:MechanicalTesting
                                                                                                                                                                      figure8secondattempt:PerformanceTesting
                                                                                                                                                                    )
                                                                                                                                                      ]
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:MechanicalTesting
                                                                                                                                  ]
                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                    owl:onClass figure8secondattempt:PerformanceTesting
                                                                                                                                  ]
                                                                                                                                ) ;
                                                                                                             rdf:type owl:Class
                                                                                                           ] ;
                                                                                       rdfs:subClassOf figure8secondattempt:Iteration ;
                                                                                       rdfs:comment "An Iteration that involves CAE/virtual testing, mechanical testing, and performance testing." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Loop
figure8secondattempt:Loop rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Loop
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:hasStep ;
                                                                       owl:minCardinality "2"^^xsd:nonNegativeInteger
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:isRepeated ;
                                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onDataRange xsd:boolean
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf figure8secondattempt:Flow ;
                          rdfs:comment """A Loop is a Flow that may be repeated. 

Unlike an Iteration which is not necessarily ordered, a Loop has an ordered sequence of Steps."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting
figure8secondattempt:MechanicalTesting rdf:type owl:Class ;
                                       rdfs:subClassOf figure8secondattempt:PhysicalTesting .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model
figure8secondattempt:Model rdf:type owl:Class ;
                           rdfs:subClassOf figure8secondattempt:Artefact ;
                           rdfs:comment "A Model is a representation of something that exists in reality. An architectural model can be a physical or digital representation of a building. An information model is a digital representation of some knowledge domain (this ontology is an information model)."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Modelling
figure8secondattempt:Modelling rdf:type owl:Class ;
                               rdfs:subClassOf figure8secondattempt:ModellingAndSimulation ;
                               rdfs:comment "A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on modelling."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation
figure8secondattempt:ModellingAndSimulation rdf:type owl:Class ;
                                            rdfs:subClassOf figure8secondattempt:DevelopmentActivity ;
                                            owl:disjointWith figure8secondattempt:Procurement ;
                                            rdfs:comment "A DevelopmentActivity that consists of modelling and/or simulation, or a composition of DevelopmentActivities, that is primarily focussed on modelling and/or simulation."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output
figure8secondattempt:Output rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Output
                                                                       [ rdf:type owl:Class ;
                                                                         owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                                                owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty figure8secondattempt:hasArtefact ;
                                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                owl:onClass figure8secondattempt:Artefact
                                                                                                                              ]
                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty figure8secondattempt:hasComponent ;
                                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                owl:onClass figure8secondattempt:Component
                                                                                                                              ]
                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                owl:onProperty figure8secondattempt:hasParameter ;
                                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                owl:onClass figure8secondattempt:Parameter
                                                                                                                              ]
                                                                                                                            )
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty figure8secondattempt:outputFrom ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass [ rdf:type owl:Class ;
                                                                                                                              owl:unionOf ( figure8secondattempt:DevelopmentActivity
                                                                                                                                            figure8secondattempt:TemporalConstruct
                                                                                                                                          )
                                                                                                                            ]
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty figure8secondattempt:hasEnvironment ;
                                                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                         owl:onClass figure8secondattempt:Environment
                                                                                       ]
                                                                                     )
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            owl:disjointWith figure8secondattempt:TemporalConstruct ;
                            rdfs:comment """\"An Output consists of the things that are produced or changed during a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact that is developed during some DevelopmentActivity. It is then part of the Output from that DevelopmentActivity, and will most likely form part of the Input to another DevelopmentActivity. 

An item of information, such as a Datapoint, may also form part of an Output. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity.\""""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter
figure8secondattempt:Parameter rdf:type owl:Class ;
                               owl:disjointWith figure8secondattempt:TemporalConstruct ;
                               rdfs:comment "A Parameter is an item of information that forms part of the Input to, or Output from, some DevelopmentActivity or TemporalConstruct in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting
figure8secondattempt:PerformanceTesting rdf:type owl:Class ;
                                        rdfs:subClassOf figure8secondattempt:PhysicalTesting .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalDevelopmentEnvironment
figure8secondattempt:PhysicalDevelopmentEnvironment rdf:type owl:Class ;
                                                    rdfs:subClassOf figure8secondattempt:DevelopmentEnvironment ;
                                                    owl:disjointWith figure8secondattempt:VirtualDevelopmentEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalEntity
figure8secondattempt:PhysicalEntity rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:PhysicalEntity
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty figure8secondattempt:isPhysicalEntityOf ;
                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass figure8secondattempt:DigitalTwin
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty figure8secondattempt:twinnedDigitallyWith ;
                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass figure8secondattempt:DigitalEntity
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:subClassOf figure8secondattempt:DigitalTwin ;
                                    rdfs:comment "The physical part of the product being developed throughout the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalModel
figure8secondattempt:PhysicalModel rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:PhysicalModel
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty figure8secondattempt:hasDescription ;
                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onDataRange xsd:string
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                   rdfs:subClassOf figure8secondattempt:Model ;
                                   owl:disjointWith figure8secondattempt:VirtualModel ;
                                   rdfs:comment "A physical model will not fit in an ontology, so must be accompanied by at least one text description."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTestEnvironment
figure8secondattempt:PhysicalTestEnvironment rdf:type owl:Class ;
                                             rdfs:subClassOf figure8secondattempt:TestEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting
figure8secondattempt:PhysicalTesting rdf:type owl:Class ;
                                     rdfs:subClassOf figure8secondattempt:TestingActivity ;
                                     owl:disjointWith figure8secondattempt:VirtualTesting ;
                                     rdfs:comment "Testing of objects in the physical world."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement
figure8secondattempt:Procurement rdf:type owl:Class ;
                                 rdfs:subClassOf figure8secondattempt:DevelopmentActivity ;
                                 owl:disjointWith figure8secondattempt:ReleaseActivity ,
                                                  figure8secondattempt:TestingActivity ;
                                 rdfs:comment "A DevelopmentActivity, or composition of DevelopmentActivities, that primarily involves procurement."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Product
figure8secondattempt:Product rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Product
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty figure8secondattempt:hasArtefact ;
                                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                          owl:onClass figure8secondattempt:DigitalTwin
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf figure8secondattempt:Artefact ;
                             rdfs:comment "The thing that is produced - and may or may not be sold, depending on the context - as the culmination of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage
figure8secondattempt:ProductDevelopmentStage rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:ProductDevelopmentStage
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty figure8secondattempt:hasNext ;
                                                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass figure8secondattempt:TemporalPartition
                                                                                        ]
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty figure8secondattempt:hasPrevious ;
                                                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass figure8secondattempt:TemporalPartition
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:subClassOf figure8secondattempt:TemporalPartition ;
                                             rdfs:comment "In this ontology, we assume that a ProductDevelopmentStage is part of a stage-gate process, but the ontology should be extensible to accommodate other development process models."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProgressiveRelease
figure8secondattempt:ProgressiveRelease rdf:type owl:Class ;
                                        rdfs:subClassOf figure8secondattempt:ReleaseActivity ;
                                        rdfs:comment "A ReleaseActivity that is carried out progressively over some TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity
figure8secondattempt:ReleaseActivity rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:ReleaseActivity
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty figure8secondattempt:hasOutput ;
                                                                                  owl:someValuesFrom figure8secondattempt:Output
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf figure8secondattempt:DevelopmentActivity ;
                                     rdfs:comment "A DevelopmentActivity, or composition of DevelopmentActivities, that relates mainly to the release of some deliverable."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Shadow
figure8secondattempt:Shadow rdf:type owl:Class ;
                            rdfs:subClassOf figure8secondattempt:Model ;
                            rdfs:comment "A Shadow is more evolved (closer to meeting the required conditions after physical and virtual testing) than a model." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Simulation
figure8secondattempt:Simulation rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Simulation
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty figure8secondattempt:hasURI ;
                                                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                             owl:onDataRange xsd:anyURI
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf figure8secondattempt:Artefact ;
                                rdfs:comment "A simulation of some real-world object or process; or, the output from a SimulationActivity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SimulationActivity
figure8secondattempt:SimulationActivity rdf:type owl:Class ;
                                        rdfs:subClassOf figure8secondattempt:ModellingAndSimulation ;
                                        rdfs:comment "A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on simulation."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span
figure8secondattempt:Span rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Span
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                       owl:someValuesFrom figure8secondattempt:DevelopmentActivity
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:duringTemporalPartition ;
                                                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:TemporalPartition
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:spansFrom ;
                                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:TemporalPartition
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:spansTo ;
                                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:TemporalPartition
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf figure8secondattempt:TimeStructure ;
                          owl:disjointWith figure8secondattempt:Step ;
                          rdfs:comment """A Span links two DevelopmentActivities across one or more TemporalPartitions.

Spans can be sequentially linked, using the followsFrom and leadsTo properties, to form a Continuity across TemporalPartitions of the development process.

A Span differs from a Step in that a Span is part of a Continuity, which begins and ends in two different TemporalPartitions. Therefore the TemporalPartitions of a Span must be specified as part of the Span's definition."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step
figure8secondattempt:Step rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Step
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:stepFrom ;
                                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:DevelopmentActivity
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:stepTo ;
                                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:DevelopmentActivity
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:hasNext ;
                                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:Step
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:hasPrevious ;
                                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onClass figure8secondattempt:Step
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty figure8secondattempt:isOptional ;
                                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                       owl:onDataRange xsd:boolean
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf figure8secondattempt:TimeStructure ;
                          rdfs:comment """A Step connects one DevelopmentActivity to another.

Steps can be sequentially linked, using the hasPrevious and hasNext properties, to form a Flow.

A Step forms part of a Flow, which takes place within exactly one TemporalPartition. A Step differs from a Span in that the DevelopmentActivities connected by a Step always begin in the same TemporalPartition. The TemporalPartition is the same as the one specified in the Flow, so does not have to be specified at each Step of the Flow."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToDesignActivity
figure8secondattempt:Step_CAE_VirtualTestingToDesignActivity rdf:type owl:Class ;
                                                             owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Step
                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty figure8secondattempt:stepFrom ;
                                                                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                          owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                        ]
                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty figure8secondattempt:stepTo ;
                                                                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                          owl:onClass figure8secondattempt:DesignActivity
                                                                                                        ]
                                                                                                      ) ;
                                                                                   rdf:type owl:Class
                                                                                 ] ;
                                                             rdfs:subClassOf figure8secondattempt:Step ;
                                                             rdfs:comment "A Step from CAE/virtual testing to design activity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToPerformanceTesting
figure8secondattempt:Step_CAE_VirtualTestingToPerformanceTesting rdf:type owl:Class ;
                                                                 owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Step
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty figure8secondattempt:stepFrom ;
                                                                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                              owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                            ]
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty figure8secondattempt:stepTo ;
                                                                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                              owl:onClass figure8secondattempt:PerformanceTesting
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ] ;
                                                                 rdfs:subClassOf figure8secondattempt:Step ;
                                                                 rdfs:comment "A Step from CAE/virtual testing to performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToProcurement
figure8secondattempt:Step_CAE_VirtualTestingToProcurement rdf:type owl:Class ;
                                                          owl:equivalentClass [ owl:intersectionOf ( figure8secondattempt:Step
                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                       owl:onProperty figure8secondattempt:stepFrom ;
                                                                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                       owl:onClass figure8secondattempt:CAE_VirtualTesting
                                                                                                     ]
                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                       owl:onProperty figure8secondattempt:stepTo ;
                                                                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                       owl:onClass figure8secondattempt:Procurement
                                                                                                     ]
                                                                                                   ) ;
