                                                          figure8secondattempt:TemporalConstruct
                                                        )
                                          ] ;
                              rdfs:range figure8secondattempt:Input ;
                              rdfs:comment "Input into some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasModel
figure8secondattempt:hasModel rdf:type owl:ObjectProperty ;
                              owl:inverseOf figure8secondattempt:isModelOf ;
                              rdfs:range figure8secondattempt:Model ;
                              rdfs:comment "Model associated with an entity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasNext
figure8secondattempt:hasNext rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasOutput
figure8secondattempt:hasOutput rdf:type owl:ObjectProperty ;
                               owl:inverseOf figure8secondattempt:outputFrom ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( figure8secondattempt:Artefact
