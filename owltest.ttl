                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:duringTemporalPartition ;
                                                                            owl:someValuesFrom figure8secondattempt:TemporalPartition
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:hasDevelopmentActivity ;
                                                                            owl:someValuesFrom figure8secondattempt:DevelopmentActivity
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty figure8secondattempt:isRepeated ;
                                                                            owl:hasValue "true"^^xsd:boolean
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf figure8secondattempt:TimeStructure ;
                               owl:disjointWith figure8secondattempt:Span ,
                                                figure8secondattempt:Step ;
                               rdfs:comment """An Iteration groups DevelopmentActivities that are carried out together in cycles that may be repeated. 

Iterations that occur more than once during the development process may be defined as subclasses. The existing subclasses are not exhaustive.

The DevelopmentActivities in an Iteration are not assumed to be carried out in sequence or in any particular order."""@en .


