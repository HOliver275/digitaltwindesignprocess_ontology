                                                                                                                                    owl:unionOf ( :CAE_VirtualTesting
                                                                                                                                                  :EngineeringDesign
                                                                                                                                                  :PerformanceTesting
                                                                                                                                                )
                                                                                                                                  ]
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :CAE_VirtualTesting
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :EngineeringDesign
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :PerformanceTesting
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ] ;
                                                                   rdfs:subClassOf :Iteration ;
                                                                   rdfs:comment "An Iteration that includes CAE/virtual testing, engineering design, and performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting_MechanicalTesting
:Iteration_CAE_VirtualTesting_EngineeringDesign_PerformanceTesting_MechanicalTesting rdf:type owl:Class ;
                                                                                     owl:equivalentClass [ owl:intersectionOf ( :Iteration
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                                      owl:unionOf ( :CAE_VirtualTesting
                                                                                                                                                                    :EngineeringDesign
                                                                                                                                                                    :MechanicalTesting
                                                                                                                                                                    :PerformanceTesting
                                                                                                                                                                  )
                                                                                                                                                    ]
                                                                                                                                ]
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                  owl:onClass :CAE_VirtualTesting
                                                                                                                                ]
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                  owl:onClass :EngineeringDesign
                                                                                                                                ]
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                  owl:onClass :MechanicalTesting
                                                                                                                                ]
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                  owl:onClass :PerformanceTesting
                                                                                                                                ]
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ] ;
                                                                                     rdfs:subClassOf :Iteration ;
                                                                                     rdfs:comment "An Iteration that includes CAE/virtual testing, engineering design, mechanical testing, and performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting
:Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting rdf:type owl:Class ;
                                                                   owl:equivalentClass [ owl:intersectionOf ( :Iteration
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                                    owl:unionOf ( :CAE_VirtualTesting
                                                                                                                                                  :MechanicalTesting
                                                                                                                                                  :PerformanceTesting
                                                                                                                                                )
                                                                                                                                  ]
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :CAE_VirtualTesting
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :MechanicalTesting
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasDevelopmentActivity ;
                                                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                owl:onClass :PerformanceTesting
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ] ;
                                                                   rdfs:subClassOf :Iteration ;
                                                                   rdfs:comment "An Iteration that involves CAE/virtual testing, mechanical testing, and performance testing." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Loop
:Loop rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :Loop
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasStep ;
                                                   owl:minCardinality "2"^^xsd:nonNegativeInteger
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :isRepeated ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:boolean
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :Flow ;
      rdfs:comment """A Loop is a Flow that may be repeated. 

Unlike an Iteration which is not necessarily ordered, a Loop has an ordered sequence of Steps."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting
:MechanicalTesting rdf:type owl:Class ;
                   rdfs:subClassOf :PhysicalTesting .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model
:Model rdf:type owl:Class ;
       rdfs:subClassOf :Artefact ;
       rdfs:comment "A Model is a representation of something that exists in reality. An architectural model can be a physical or digital representation of a building. An information model is a digital representation of some knowledge domain (this ontology is an information model)."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Modelling
:Modelling rdf:type owl:Class ;
           rdfs:subClassOf :ModellingAndSimulation ;
           rdfs:comment "A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on modelling."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation
:ModellingAndSimulation rdf:type owl:Class ;
                        rdfs:subClassOf :DevelopmentActivity ;
                        owl:disjointWith :Procurement ;
                        rdfs:comment "A DevelopmentActivity that consists of modelling and/or simulation, or a composition of DevelopmentActivities, that is primarily focussed on modelling and/or simulation."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output
:Output rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :Output
                                                   [ rdf:type owl:Class ;
                                                     owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty :hasArtefact ;
                                                                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass :Artefact
                                                                                                          ]
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty :hasComponent ;
                                                                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass :Component
                                                                                                          ]
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty :hasParameter ;
                                                                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass :Parameter
                                                                                                          ]
                                                                                                        )
                                                                                          ]
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty :outputFrom ;
                                                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                            owl:onClass [ rdf:type owl:Class ;
                                                                                                          owl:unionOf ( :DevelopmentActivity
                                                                                                                        :TemporalConstruct
                                                                                                                      )
                                                                                                        ]
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasEnvironment ;
                                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                     owl:onClass :Environment
                                                                   ]
                                                                 )
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        owl:disjointWith :TemporalConstruct ;
        rdfs:comment """\"An Output consists of the things that are produced or changed during a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact that is developed during some DevelopmentActivity. It is then part of the Output from that DevelopmentActivity, and will most likely form part of the Input to another DevelopmentActivity. 

An item of information, such as a Datapoint, may also form part of an Output. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity.\""""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter
:Parameter rdf:type owl:Class ;
           owl:disjointWith :TemporalConstruct ;
           rdfs:comment "A Parameter is an item of information that forms part of the Input to, or Output from, some DevelopmentActivity or TemporalConstruct in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting
:PerformanceTesting rdf:type owl:Class ;
                    rdfs:subClassOf :PhysicalTesting .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalDevelopmentEnvironment
:PhysicalDevelopmentEnvironment rdf:type owl:Class ;
                                rdfs:subClassOf :DevelopmentEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalEntity
:PhysicalEntity rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :PhysicalEntity
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isPhysicalEntityOf ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :DigitalTwin
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :twinnedDigitallyWith ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :DigitalEntity
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :DigitalTwin ;
                rdfs:comment "The physical part of the product being developed throughout the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalModel
:PhysicalModel rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :PhysicalModel
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasDescription ;
                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:string
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Model ;
               owl:disjointWith :VirtualModel ;
               rdfs:comment "A physical model will not fit in an ontology, so must be accompanied by at least one text description."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTestEnvironment
:PhysicalTestEnvironment rdf:type owl:Class ;
                         rdfs:subClassOf :TestEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting
:PhysicalTesting rdf:type owl:Class ;
                 rdfs:subClassOf :TestingActivity ;
                 owl:disjointWith :VirtualTesting ;
                 rdfs:comment "Testing of objects in the physical world."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement
:Procurement rdf:type owl:Class ;
             rdfs:subClassOf :DevelopmentActivity ;
             owl:disjointWith :ReleaseActivity ,
                              :TestingActivity ;
             rdfs:comment "A DevelopmentActivity, or composition of DevelopmentActivities, that primarily involves procurement."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Product
:Product rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Product
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasArtefact ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass :DigitalTwin
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf :Artefact ;
         rdfs:comment "The thing that is produced - and may or may not be sold, depending on the context - as the culmination of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage
:ProductDevelopmentStage rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :ProductDevelopmentStage
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasNext ;
                                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                      owl:onClass :TemporalPartition
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasPrevious ;
                                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                      owl:onClass :TemporalPartition
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :TemporalPartition ;
                         rdfs:comment "In this ontology, we assume that a ProductDevelopmentStage is part of a stage-gate process, but the ontology should be extensible to accommodate other development process models."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProgressiveRelease
:ProgressiveRelease rdf:type owl:Class ;
                    rdfs:subClassOf :ReleaseActivity ;
                    rdfs:comment "A ReleaseActivity that is carried out progressively over some TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity
:ReleaseActivity rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :ReleaseActivity
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasOutput ;
                                                              owl:someValuesFrom :Output
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :DevelopmentActivity ;
                 rdfs:comment "A DevelopmentActivity, or composition of DevelopmentActivities, that relates mainly to the release of some deliverable."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Shadow
:Shadow rdf:type owl:Class ;
        rdfs:subClassOf :Model .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Simulation
:Simulation rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Simulation
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasURI ;
                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:anyURI
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Artefact ;
            rdfs:comment "A simulation of some real-world object or process; or, the output from a SimulationActivity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SimulationActivity
:SimulationActivity rdf:type owl:Class ;
                    rdfs:subClassOf :ModellingAndSimulation ;
                    rdfs:comment "A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on simulation."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span
:Span rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :Span
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasDevelopmentActivity ;
                                                   owl:someValuesFrom :DevelopmentActivity
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :duringTemporalPartition ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :TemporalPartition
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :spansFrom ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :TemporalPartition
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :spansTo ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :TemporalPartition
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :TimeStructure ;
      owl:disjointWith :Step ;
      rdfs:comment """A Span links two DevelopmentActivities across one or more TemporalPartitions.

Spans can be sequentially linked, using the followsFrom and leadsTo properties, to form a Continuity across TemporalPartitions of the development process.

A Span differs from a Step in that a Span is part of a Continuity, which begins and ends in two different TemporalPartitions. Therefore the TemporalPartitions of a Span must be specified as part of the Span's definition."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step
:Step rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :Step
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :stepFrom ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :DevelopmentActivity
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :stepTo ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :DevelopmentActivity
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasNext ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :Step
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasPrevious ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :Step
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :isOptional ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:boolean
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :TimeStructure ;
      rdfs:comment """A Step connects one DevelopmentActivity to another.

Steps can be sequentially linked, using the hasPrevious and hasNext properties, to form a Flow.

A Step forms part of a Flow, which takes place within exactly one TemporalPartition. A Step differs from a Span in that the DevelopmentActivities connected by a Step always begin in the same TemporalPartition. The TemporalPartition is the same as the one specified in the Flow, so does not have to be specified at each Step of the Flow."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToDesignActivity
:Step_CAE_VirtualTestingToDesignActivity rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepFrom ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :CAE_VirtualTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepTo ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :DesignActivity
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :Step ;
                                         rdfs:comment "A Step from CAE/virtual testing to design activity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToPerformanceTesting
:Step_CAE_VirtualTestingToPerformanceTesting rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :stepFrom ;
                                                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass :CAE_VirtualTesting
                                                                                        ]
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :stepTo ;
                                                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass :PerformanceTesting
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:subClassOf :Step ;
                                             rdfs:comment "A Step from CAE/virtual testing to performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_CAE_VirtualTestingToProcurement
:Step_CAE_VirtualTestingToProcurement rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :stepFrom ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass :CAE_VirtualTesting
                                                                                 ]
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :stepTo ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass :Procurement
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:subClassOf :Step ;
                                      rdfs:comment "A Step from CAE/virtual testing to procurement."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_DesignActivityToCAE_VirtualTesting
:Step_DesignActivityToCAE_VirtualTesting rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepFrom ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :DesignActivity
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepTo ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :CAE_VirtualTesting
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :Step ;
                                         rdfs:comment "A Step from design activity to CAE/virtual testing." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_DesignActivityToProcurement
:Step_DesignActivityToProcurement rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :stepFrom ;
                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :DesignActivity
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :stepTo ;
                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :Procurement
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf :Step ;
                                  rdfs:comment "A Step from design activity to procurement." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_MechanicalTestingToCAE_VirtualTesting
:Step_MechanicalTestingToCAE_VirtualTesting rdf:type owl:Class ;
                                            owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty :stepFrom ;
                                                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                         owl:onClass :MechanicalTesting
                                                                                       ]
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty :stepTo ;
                                                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                         owl:onClass :CAE_VirtualTesting
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                            rdfs:subClassOf :Step ;
                                            rdfs:comment "A Step from mechanical testing to CAE/virtual testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_PerformanceTestingToDesignActivity
:Step_PerformanceTestingToDesignActivity rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepFrom ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :PerformanceTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :stepTo ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :DesignActivity
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :Step ;
                                         rdfs:comment "A Step from performance testing to design activity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_PerformanceTestingToMechanicalTesting
:Step_PerformanceTestingToMechanicalTesting rdf:type owl:Class ;
                                            owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty :stepFrom ;
                                                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                         owl:onClass :PerformanceTesting
                                                                                       ]
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty :stepTo ;
                                                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                         owl:onClass :MechanicalTesting
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                            rdfs:subClassOf :Step ;
                                            rdfs:comment "A Step from performance testing to mechanical testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_ProcurementToMechanicalTesting
:Step_ProcurementToMechanicalTesting rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :stepFrom ;
                                                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                  owl:onClass :Procurement
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :stepTo ;
                                                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                  owl:onClass :MechanicalTesting
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf :Step ;
                                     rdfs:comment "A Step from procurement to mechanical testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_ProcurementToPerformanceTesting
:Step_ProcurementToPerformanceTesting rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( :Step
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :stepFrom ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass :Procurement
                                                                                 ]
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :stepTo ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass :PerformanceTesting
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:subClassOf :Step ;
                                      rdfs:comment "A Step from procurement to performance testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SystemLevelDesign
:SystemLevelDesign rdf:type owl:Class ;
                   rdfs:subClassOf :ProductDevelopmentStage ;
                   rdfs:comment "The system-level design stage of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct
:TemporalConstruct rdf:type owl:Class ;
                   rdfs:comment "A TemporalConstruct is a way of representing time in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition
:TemporalPartition rdf:type owl:Class ;
                   rdfs:subClassOf :TemporalConstruct ;
                   owl:disjointWith :TimeStructure ;
                   rdfs:comment "A TemporalPartition represents some distinct time period in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestEnvironment
:TestEnvironment rdf:type owl:Class ;
                 rdfs:subClassOf :Environment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingActivity
:TestingActivity rdf:type owl:Class ;
                 rdfs:subClassOf :DevelopmentActivity ;
                 rdfs:comment "A DevelopmentActivity, or a composition of DevelopmentActivities, that relates primarily to testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingFocus
:TestingFocus rdf:type owl:Class ;
              rdfs:subClassOf :Focus ;
              rdfs:comment "What the testing is focussed on at some point in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingInput
:TestingInput rdf:type owl:Class ;
              rdfs:subClassOf :Input ;
              rdfs:comment "Input into some TestingActivity, or primarily testing-related input into some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingOutput
:TestingOutput rdf:type owl:Class ;
               rdfs:subClassOf :Output ;
               rdfs:comment "Output from some TestingActivity, or primarily testing-related output from some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure
:TimeStructure rdf:type owl:Class ;
               rdfs:subClassOf :TemporalConstruct .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualDevelopmentEnvironment
:VirtualDevelopmentEnvironment rdf:type owl:Class ;
                               rdfs:subClassOf :DevelopmentEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualModel
:VirtualModel rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :VirtualModel
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasURI ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:anyURI
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :Model .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualTestEnvironment
:VirtualTestEnvironment rdf:type owl:Class ;
                        rdfs:subClassOf :TestEnvironment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualTesting
:VirtualTesting rdf:type owl:Class ;
                rdfs:subClassOf :TestingActivity ;
                rdfs:comment "Testing that is carried out on data objects, rather than on physical objects."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel
<http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel> rdf:type owl:Class ;
                                                                                        owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel>
                                                                                                                                   [ rdf:type owl:Class ;
                                                                                                                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                                     owl:onProperty :hasDescription ;
                                                                                                                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                     owl:onDataRange xsd:string
                                                                                                                                                   ]
                                                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                                                     owl:onProperty :hasURI ;
                                                                                                                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                     owl:onDataRange xsd:anyURI
                                                                                                                                                   ]
                                                                                                                                                 )
                                                                                                                                   ]
                                                                                                                                 ) ;
                                                                                                              rdf:type owl:Class
                                                                                                            ] ;
                                                                                        rdfs:subClassOf :Model ;
                                                                                        rdfs:comment "A 2D model can be physical or virtual. At minimum, it must have either a description providing the minimum useful information (such as where the physical 2D model can be found), or the URI where the virtual model can be found." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#3DModel
<http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#3DModel> rdf:type owl:Class ;
                                                                                        owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#3DModel>
                                                                                                                                   [ rdf:type owl:Class ;
                                                                                                                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                                     owl:onProperty :hasDescription ;
                                                                                                                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                     owl:onDataRange xsd:string
                                                                                                                                                   ]
                                                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                                                     owl:onProperty :hasURI ;
                                                                                                                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                                                     owl:onDataRange xsd:anyURI
                                                                                                                                                   ]
                                                                                                                                                 )
                                                                                                                                   ]
                                                                                                                                 ) ;
                                                                                                              rdf:type owl:Class
                                                                                                            ] ;
                                                                                        rdfs:subClassOf :Model ;
                                                                                        rdfs:comment "A 3D model can be physical or virtual. At minimum, it must have either a description providing the minimum useful information (such as where the physical 3D model can be found), or the URI where the virtual model can be found." .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact1
:Artefact1 rdf:type owl:NamedIndividual ,
                    :Artefact .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CADModel_Fig6_1
:CADModel_Fig6_1 rdf:type owl:NamedIndividual ,
                          :CADModel ;
                 :hasURI "http://example.com/cadmodel/fig6_1/"^^xsd:anyURI .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAEActivity1
