@prefix : <http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#> .

<http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closedByGateway
:closedByGateway rdf:type owl:ObjectProperty ;
                 owl:inverseOf :closesStage ;
                 rdfs:domain :ProductDevelopmentStage ;
                 rdfs:range :Gateway ;
                 rdfs:comment "In a stage-gate development process, a ProductDevelopmentStage is closed by a Gateway, provided certain conditions are met."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closesStage
:closesStage rdf:type owl:ObjectProperty ;
             rdfs:domain :Gateway ;
             rdfs:range :ProductDevelopmentStage ;
             rdfs:comment "A Gateway closes a ProductDevelopmentStage in a stage-gate development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesAfter
:comesAfter rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:comment "Anything that must be preceded by some other thing or things at some point in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesBefore
:comesBefore rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdf:type owl:TransitiveProperty ;
             rdfs:comment "Anything that must precede some other thing or things at some point in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityFrom
:continuityFrom rdf:type owl:ObjectProperty ;
                rdfs:domain :Continuity ;
                rdfs:range :TemporalPartition ;
                rdfs:comment "The TemporalPartition where a Continuity begins."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityTo
:continuityTo rdf:type owl:ObjectProperty ;
              rdfs:domain :Continuity ;
              rdfs:range :TemporalPartition ;
              rdfs:comment "The TemporalPartition where a Continuity ends."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#duringTemporalPartition
:duringTemporalPartition rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :DevelopmentActivity
                                                     :TimeStructure
                                                   )
                                     ] ;
                         rdfs:range :TemporalPartition ;
                         rdfs:comment "A DevelopmentActivity, or a TemporalConstruct that is not itself a TemporalPartition, takes place during a TemporalPartition in the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#endsWith
:endsWith rdf:type owl:ObjectProperty ;
          owl:inverseOf :isEndOf ;
          rdfs:domain :TimeStructure ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :DevelopmentActivity
                                     :TemporalConstruct
                                   )
                     ] ;
          rdfs:comment "The DevelopmentActivity or TemporalConstruct at the end of a TimeStructure."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#followsFrom
:followsFrom rdf:type owl:ObjectProperty ;
             owl:inverseOf :isFollowedBy ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :DevelopmentActivity
                                         :Input
                                         :Output
                                         :TemporalConstruct
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :DevelopmentActivity
                                        :TemporalConstruct
                                      )
                        ] ;
             rdfs:comment "One DevelopmentActivity or TemporalConstruct leads to another, sometimes."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact
:hasArtefact rdf:type owl:ObjectProperty ;
             owl:inverseOf :isArtefactOf ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Component
                                         :DevelopmentActivity
                                         :Input
                                         :Output
                                         :TemporalConstruct
                                       )
                         ] ;
             rdfs:range :Artefact ;
             rdfs:comment "Artefact associated with a DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              owl:inverseOf :isComponentOf ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Artefact
                                          :Component
                                          :DevelopmentActivity
                                          :Input
                                          :Output
                                        )
                          ] ;
              rdfs:range :Component ;
              rdfs:comment "Component associated with a DevelopmentActivity or TemporalConstruct or Input or Output"@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDeliverable
:hasDeliverable rdf:type owl:ObjectProperty ;
                owl:inverseOf :isDeliverableOf ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :DevelopmentActivity
                                            :TemporalConstruct
                                          )
                            ] ;
                rdfs:range :Deliverable ;
                rdfs:comment "The Deliverable of some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity
:hasDevelopmentActivity rdf:type owl:ObjectProperty ;
                        owl:inverseOf :isDevelopmentActivityOf ;
                        rdfs:range :DevelopmentActivity ;
                        rdfs:comment "The DevelopmentActivity associated with some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDigitalEntity
:hasDigitalEntity rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isDigitalEntityOf ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :DigitalTwin ;
                  rdfs:range :DigitalEntity ;
                  rdfs:comment "A PhysicalEntity has a DigitalEntity. To associate the DigitalEntity with some other entity, use hasArtefact."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasEnvironment
:hasEnvironment rdf:type owl:ObjectProperty ;
                owl:inverseOf :isEnvironmentOf .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasFocus
:hasFocus rdf:type owl:ObjectProperty ;
          owl:inverseOf :isFocusOf ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Artefact
                                      :DevelopmentActivity
                                      :TemporalConstruct
                                    )
                      ] ;
          rdfs:range :Focus ;
          rdfs:comment "The focus of some aspect of the development process." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          owl:inverseOf :inputInto ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Artefact
                                      :DevelopmentActivity
                                      :TemporalConstruct
                                    )
                      ] ;
          rdfs:range :Input ;
          rdfs:comment "Input into some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasModel
:hasModel rdf:type owl:ObjectProperty ;
          owl:inverseOf :isModelOf ;
          rdfs:range :Model ;
          rdfs:comment "Model associated with an entity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasNext
:hasNext rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           owl:inverseOf :outputFrom ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Artefact
                                       :DevelopmentActivity
                                       :TemporalConstruct
                                     )
                       ] ;
           rdfs:range :Output ;
           rdfs:comment "Output from some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              owl:inverseOf :isParameterOf ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Input
                                          :Output
                                        )
                          ] ;
              rdfs:range :Parameter ;
              rdfs:comment "An input or output Parameter."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasPhysicalEntity
:hasPhysicalEntity rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isPhysicalEntityOf ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :DigitalTwin ;
                   rdfs:range :PhysicalEntity ;
                   rdfs:comment "A DigitalEntity is twinned with a PhysicalEntity. To associate the PhysicalEntity with some other entity, use hasArtefact."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasPrevious
:hasPrevious rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasProduct
:hasProduct rdf:type owl:ObjectProperty ;
            owl:inverseOf :isProductOf ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :DevelopmentActivity
                                        :TemporalConstruct
                                      )
                        ] ;
            rdfs:range :Product ;
            rdfs:comment "The product of some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasSpan
:hasSpan rdf:type owl:ObjectProperty ;
         rdfs:range :Span .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasStep
:hasStep rdf:type owl:ObjectProperty ;
         rdfs:range :Step .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#inputInto
:inputInto rdf:type owl:ObjectProperty ;
           rdfs:domain :Input ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Artefact
                                      :DevelopmentActivity
                                      :TemporalConstruct
                                    )
                      ] ;
           rdfs:comment "Input into some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isArtefactOf
:isArtefactOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Artefact ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :DevelopmentActivity
                                         :Input
                                         :Output
                                         :TemporalConstruct
                                       )
                         ] ;
              rdfs:comment "Artefact of some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               rdfs:domain :Component ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Artefact
                                          :Component
                                          :DevelopmentActivity
                                          :Input
                                          :Output
                                        )
                          ] ;
               rdfs:comment "Component associated with a DevelopmentActivity or TemporalConstruct or Input or Output"@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isDeliverableOf
:isDeliverableOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :Deliverable ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :DevelopmentActivity
                                            :TemporalConstruct
                                          )
                            ] ;
                 rdfs:comment "The Deliverable of some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isDevelopmentActivityOf
:isDevelopmentActivityOf rdf:type owl:ObjectProperty ;
                         rdfs:domain :DevelopmentActivity ;
                         rdfs:comment "DevelopmentActivity associated with some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isDigitalEntityOf
:isDigitalEntityOf rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :DigitalEntity ;
                   rdfs:range :DigitalTwin ;
                   rdfs:comment "A DigitalTwin is twinned with a PhysicalAsset. To associate the DigitalTwin with some other entity, use isArtefactOf."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isEndOf
:isEndOf rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DevelopmentActivity
                                     :TemporalConstruct
                                   )
                     ] ;
         rdfs:range :TimeStructure ;
         rdfs:comment "The DevelopmentActivity or TemporalConstruct at the end of a TimeStructure."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isEnvironmentOf
:isEnvironmentOf rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isFocusOf
:isFocusOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Focus ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Artefact
                                      :DevelopmentActivity
                                      :TemporalConstruct
                                    )
                      ] ;
           rdfs:comment "The focus of some aspect of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isFollowedBy
:isFollowedBy rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :DevelopmentActivity
                                          :Input
                                          :Output
                                          :TemporalConstruct
                                        )
                          ] ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :DevelopmentActivity
                                         :Input
                                         :Output
                                         :TemporalConstruct
                                       )
                         ] ;
              rdfs:comment "One DevelopmentActivity or TemporalConstruct leads to another, sometimes."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isLedToBy
:isLedToBy rdf:type owl:ObjectProperty ;
           owl:inverseOf :leadsTo ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :DevelopmentActivity
                                       :Input
                                       :Output
                                       :TemporalConstruct
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :DevelopmentActivity
                                      :Input
                                      :Output
                                      :TemporalConstruct
                                    )
                      ] ;
           rdfs:comment "One DevelopmentActivity or TemporalConstruct leads to another, sometimes."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isModelOf
:isModelOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Model ;
           rdfs:range :DigitalEntity ;
           rdfs:comment "Entity associated with a Model."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isParameterOf
:isParameterOf rdf:type owl:ObjectProperty ;
               rdfs:domain :Parameter ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Input
                                          :Output
                                        )
                          ] ;
               rdfs:comment "An input or output Parameter."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isPhysicalEntityOf
:isPhysicalEntityOf rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :PhysicalEntity ;
                    rdfs:range :DigitalTwin ;
                    rdfs:comment "A PhysicalEntity is twinned with a DigitalEntity. To associate the PhysicalEntity with some other entity, use isArtefactOf."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isProductOf
:isProductOf rdf:type owl:ObjectProperty ;
             rdfs:domain :Product ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :DevelopmentActivity
                                        :TemporalPartition
                                      )
                        ] ;
             rdfs:comment "The product of some DevelopmentActivity or TemporalConstruct."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isStartOf
:isStartOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :startsWith ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :DevelopmentActivity
                                       :TemporalConstruct
                                     )
                       ] ;
           rdfs:range :TimeStructure ;
           rdfs:comment "The DevelopmentActivity or TemporalConstruct at the start of a TimeStructure."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#leadsTo
:leadsTo rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DevelopmentActivity
                                     :Input
                                     :Output
                                     :TemporalConstruct
                                   )
                     ] ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :DevelopmentActivity
                                    :Input
                                    :Output
                                    :TemporalConstruct
                                  )
                    ] ;
         rdfs:comment "One DevelopmentActivity or TemporalConstruct leads to another, sometimes."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#openedByGateway
:openedByGateway rdf:type owl:ObjectProperty ;
                 owl:inverseOf :opensStage ;
                 rdfs:domain :ProductDevelopmentStage ;
                 rdfs:range :Gateway ;
                 rdfs:comment "In a stage-gate development process, a ProductDevelopmentStage is opened by a Gateway, provided certain conditions are met."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#opensStage
:opensStage rdf:type owl:ObjectProperty ;
            rdfs:domain :Gateway ;
            rdfs:range :ProductDevelopmentStage ;
            rdfs:comment "In a stage-gate development process, a Gateway opens a ProductDevelopmentStage, provided certain conditions are met."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#outputFrom
:outputFrom rdf:type owl:ObjectProperty ;
            rdfs:domain :Output ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Artefact
                                       :DevelopmentActivity
                                       :TemporalConstruct
                                     )
                       ] ;
            rdfs:comment "Output from some DevelopmentActivity or TemporalConstruct." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#spansFrom
:spansFrom rdf:type owl:ObjectProperty ;
           rdfs:domain :Span ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :DevelopmentActivity
                                      :TemporalPartition
                                    )
                      ] ;
           rdfs:comment "The beginning DevelopmentActivity or TemporalPartition of a Span."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#spansTo
:spansTo rdf:type owl:ObjectProperty ;
         rdfs:domain :Span ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :DevelopmentActivity
                                    :TemporalPartition
                                  )
                    ] ;
         rdfs:comment "The ending DevelopmentActivity or TemporalPartition of a Span."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#startsWith
:startsWith rdf:type owl:ObjectProperty ;
            rdfs:domain :TimeStructure ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :DevelopmentActivity
                                       :TemporalConstruct
                                     )
                       ] ;
            rdfs:comment "The DevelopmentActivity or TemporalConstruct at the start of a TimeStructure."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#stepFrom
:stepFrom rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Step ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :DevelopmentActivity
                                     :TemporalConstruct
                                   )
                     ] ;
          rdfs:comment "The DevelopmentActivity or TemporalConstruct at start of a Step."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#stepTo
:stepTo rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Step ;
        rdfs:range [ rdf:type owl:Class ;
                     owl:unionOf ( :DevelopmentActivity
                                   :TemporalConstruct
                                 )
                   ] ;
        rdfs:comment "The DevelopmentActivity or TemporalConstruct at the end of a Step."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#twinnedDigitallyWith
:twinnedDigitallyWith rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :PhysicalEntity ;
                      rdfs:range :DigitalEntity .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#twinnedPhysicallyWith
:twinnedPhysicallyWith rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :DigitalEntity ;
                       rdfs:range :PhysicalEntity .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#createdOn
:createdOn rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:dateTimeStamp ;
           rdfs:comment "Date/time stamp recording when an entity was created."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#expectedValue
:expectedValue rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasURI
:hasURI rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Dataset
                                    :Document
                                    :Model
                                  )
                    ] ;
        rdfs:range xsd:anyURI ;
        rdfs:comment "URI associated with some entity."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:domain :Datapoint ;
         rdfs:range xsd:string ;
         rdfs:comment "The unit in which some measurement is expressed."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isOptional
:isOptional rdf:type owl:DatatypeProperty ;
            rdfs:domain :Step ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Flags whether a Step is optional."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isRepeated
:isRepeated rdf:type owl:DatatypeProperty ;
            rdfs:domain :Iteration ;
            rdfs:range xsd:boolean .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#maxTargetValue
:maxTargetValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :Datapoint ;
                rdfs:comment "Maximum target value of a Datapoint. Can be any data type."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValue
:measuredValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :Datapoint ;
               rdfs:comment "Measured value of some Datapoint. Can be any datatype."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValuePhysical
:measuredValuePhysical rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :measuredValue ;
                       owl:propertyDisjointWith :measuredValueVirtual .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValueVirtual
:measuredValueVirtual rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :measuredValue .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minTargetValue
:minTargetValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :Datapoint ;
                rdfs:comment "Minimum target value of a Datapoint. Can be any data type." .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue
:prevMeasuredValue rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Datapoint ;
                   rdfs:comment "Previous value of a Datapoint. Can be any data type."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValuePhysical
:prevMeasuredValuePhysical rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :prevMeasuredValue ;
                           owl:propertyDisjointWith :prevMeasuredValueVirtual .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValueVirtual
:prevMeasuredValueVirtual rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :prevMeasuredValue .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#updatedOn
:updatedOn rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:dateTimeStamp ;
           rdfs:comment "Date/time stamp recording when an entity was updated."@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact
:Artefact rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Artefact
                                                     [ rdf:type owl:Class ;
                                                       owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasArtefact ;
                                                                       owl:someValuesFrom :Artefact
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasComponent ;
                                                                       owl:someValuesFrom :Component
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasParameter ;
                                                                       owl:someValuesFrom :Parameter
                                                                     ]
                                                                   )
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          owl:disjointWith :DevelopmentActivity ,
                           :Flow ,
                           :Focus ,
                           :Iteration ,
                           :Parameter ,
                           :Step ,
                           :TemporalConstruct ;
          rdfs:comment """An identifiable work involved in some stage or activity of the development process that:
- is disseminated or delivered as one of the intermediate or finalized results of the process; and/or
-is input into some part of the development process as an object to be analyzed, developed or tested; and
-is not merely a transitory work or information scrap that is revised, discarded or abandoned throughout the process."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CADModel
:CADModel rdf:type owl:Class ;
          rdfs:subClassOf :VirtualModel .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting
:CAE_VirtualTesting rdf:type owl:Class ;
                    rdfs:subClassOf :VirtualTesting ;
                    rdfs:comment "Computer-Aided Engineering (CAE) virtual testing"@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component
:Component rdf:type owl:Class ;
           owl:disjointWith :DevelopmentActivity ,
                            :Environment ,
                            :Focus ,
                            :TemporalConstruct ;
           rdfs:comment "A part of some whole. Could be a code module of the software which itself is a component of the DigitalTwin; or could be a part of the PhysicalAsset."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ConceptDevelopment
:ConceptDevelopment rdf:type owl:Class ;
                    rdfs:subClassOf :ProductDevelopmentStage ;
                    owl:disjointWith :DetailDesign ,
                                     :SystemLevelDesign ;
                    rdfs:comment "The concept development stage of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity
:Continuity rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Continuity
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSpan ;
                                                         owl:someValuesFrom :Span
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :duringTemporalPartition ;
                                                         owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :TemporalPartition
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :continuityFrom ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :TemporalPartition
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :continuityTo ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :TemporalPartition
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :endsWith ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :Span
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :startsWith ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :Span
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :TimeStructure ;
            owl:disjointWith :Flow ,
                             :Iteration ,
                             :Span ,
                             :Step ;
            rdfs:comment "A Continuity consists of a sequence of one or more Spans, that link two or more DevelopmentActivities, across two or more TemporalPartitions."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint
:Datapoint rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :Datapoint
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :createdOn ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:dateTimeStamp
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :expectedValue ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( rdf:PlainLiteral
                                                                                        rdf:XMLLiteral
                                                                                        rdf:langString
                                                                                        rdfs:Literal
                                                                                        xsd:NCName
                                                                                        xsd:NMTOKEN
                                                                                        xsd:Name
                                                                                        xsd:anyURI
                                                                                        xsd:base64Binary
                                                                                        xsd:boolean
                                                                                        xsd:byte
                                                                                        xsd:dateTime
                                                                                        xsd:dateTimeStamp
                                                                                        xsd:decimal
                                                                                        xsd:double
                                                                                        xsd:float
                                                                                        xsd:hexBinary
                                                                                        xsd:int
                                                                                        xsd:integer
                                                                                        xsd:language
                                                                                        xsd:long
                                                                                        xsd:negativeInteger
                                                                                        xsd:nonNegativeInteger
                                                                                        xsd:nonPositiveInteger
                                                                                        xsd:normalizedString
                                                                                        xsd:positiveInteger
                                                                                        xsd:short
                                                                                        xsd:token
                                                                                        xsd:unsignedByte
                                                                                        xsd:unsignedInt
                                                                                        xsd:unsignedLong
                                                                                        xsd:unsignedShort
                                                                                        owl:rational
                                                                                        owl:real
                                                                                      )
                                                                        ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :hasUnit ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:string
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :maxTargetValue ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( rdf:PlainLiteral
                                                                                        rdf:XMLLiteral
                                                                                        rdf:langString
                                                                                        rdfs:Literal
                                                                                        xsd:NCName
                                                                                        xsd:NMTOKEN
                                                                                        xsd:Name
                                                                                        xsd:anyURI
                                                                                        xsd:base64Binary
                                                                                        xsd:boolean
                                                                                        xsd:byte
                                                                                        xsd:dateTime
                                                                                        xsd:dateTimeStamp
                                                                                        xsd:decimal
                                                                                        xsd:double
                                                                                        xsd:float
                                                                                        xsd:hexBinary
                                                                                        xsd:int
                                                                                        xsd:integer
                                                                                        xsd:language
                                                                                        xsd:long
                                                                                        xsd:negativeInteger
                                                                                        xsd:nonNegativeInteger
                                                                                        xsd:nonPositiveInteger
                                                                                        xsd:normalizedString
                                                                                        xsd:positiveInteger
                                                                                        xsd:short
                                                                                        xsd:token
                                                                                        xsd:unsignedByte
                                                                                        xsd:unsignedInt
                                                                                        xsd:unsignedLong
                                                                                        xsd:unsignedShort
                                                                                        owl:rational
                                                                                        owl:real
                                                                                      )
                                                                        ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :measuredValue ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( rdf:PlainLiteral
                                                                                        rdf:XMLLiteral
                                                                                        rdf:langString
                                                                                        rdfs:Literal
                                                                                        xsd:NCName
                                                                                        xsd:NMTOKEN
                                                                                        xsd:Name
                                                                                        xsd:anyURI
                                                                                        xsd:base64Binary
                                                                                        xsd:boolean
                                                                                        xsd:byte
                                                                                        xsd:dateTime
                                                                                        xsd:dateTimeStamp
                                                                                        xsd:decimal
                                                                                        xsd:double
                                                                                        xsd:float
                                                                                        xsd:hexBinary
                                                                                        xsd:int
                                                                                        xsd:integer
                                                                                        xsd:language
                                                                                        xsd:long
                                                                                        xsd:negativeInteger
                                                                                        xsd:nonNegativeInteger
                                                                                        xsd:nonPositiveInteger
                                                                                        xsd:normalizedString
                                                                                        xsd:positiveInteger
                                                                                        xsd:short
                                                                                        xsd:token
                                                                                        xsd:unsignedByte
                                                                                        xsd:unsignedInt
                                                                                        xsd:unsignedLong
                                                                                        xsd:unsignedShort
                                                                                        owl:rational
                                                                                        owl:real
                                                                                      )
                                                                        ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :minTargetValue ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( rdf:PlainLiteral
                                                                                        rdf:XMLLiteral
                                                                                        rdf:langString
                                                                                        rdfs:Literal
                                                                                        xsd:NCName
                                                                                        xsd:NMTOKEN
                                                                                        xsd:Name
                                                                                        xsd:anyURI
                                                                                        xsd:base64Binary
                                                                                        xsd:boolean
                                                                                        xsd:byte
                                                                                        xsd:dateTime
                                                                                        xsd:dateTimeStamp
                                                                                        xsd:decimal
                                                                                        xsd:double
                                                                                        xsd:float
                                                                                        xsd:hexBinary
                                                                                        xsd:int
                                                                                        xsd:integer
                                                                                        xsd:language
                                                                                        xsd:long
                                                                                        xsd:negativeInteger
                                                                                        xsd:nonNegativeInteger
                                                                                        xsd:nonPositiveInteger
                                                                                        xsd:normalizedString
                                                                                        xsd:positiveInteger
                                                                                        xsd:short
                                                                                        xsd:token
                                                                                        xsd:unsignedByte
                                                                                        xsd:unsignedInt
                                                                                        xsd:unsignedLong
                                                                                        xsd:unsignedShort
                                                                                        owl:rational
                                                                                        owl:real
                                                                                      )
                                                                        ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :prevMeasuredValue ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( rdf:PlainLiteral
                                                                                        rdf:XMLLiteral
                                                                                        rdf:langString
                                                                                        rdfs:Literal
                                                                                        xsd:NCName
                                                                                        xsd:NMTOKEN
                                                                                        xsd:Name
                                                                                        xsd:anyURI
                                                                                        xsd:base64Binary
                                                                                        xsd:boolean
                                                                                        xsd:byte
                                                                                        xsd:dateTime
                                                                                        xsd:dateTimeStamp
                                                                                        xsd:decimal
                                                                                        xsd:double
                                                                                        xsd:float
                                                                                        xsd:hexBinary
                                                                                        xsd:int
                                                                                        xsd:integer
                                                                                        xsd:language
                                                                                        xsd:long
                                                                                        xsd:negativeInteger
                                                                                        xsd:nonNegativeInteger
                                                                                        xsd:nonPositiveInteger
                                                                                        xsd:normalizedString
                                                                                        xsd:positiveInteger
                                                                                        xsd:short
                                                                                        xsd:token
                                                                                        xsd:unsignedByte
                                                                                        xsd:unsignedInt
                                                                                        xsd:unsignedLong
                                                                                        xsd:unsignedShort
                                                                                        owl:rational
                                                                                        owl:real
                                                                                      )
                                                                        ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :updatedOn ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:dateTimeStamp
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :Parameter ;
           owl:disjointWith :Dataset ,
                            :Document ;
           rdfs:comment """A Datapoint is a single value of one particular type.

Units must be defined using the hasUnit data property.

A range of acceptable values can be defined using minTargetValue and maxTargetValue.

The previous value can be stored using prevValue.

To continuously track the changing value of the same Datapoint, you can do so programmatically using a database or flat file outside of the ontology."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Dataset
:Dataset rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Dataset
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasURI ;
                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:anyURI
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf :Parameter ;
         rdfs:comment """One or more links to a dataset that is a Parameter to the development process. 

A Dataset may include one or more Documents."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Deliverable
:Deliverable rdf:type owl:Class ;
             rdfs:subClassOf :Artefact ;
             rdfs:comment "A deliverable Artefact of some stage or activity of the development process, that isn't necessarily a Product or a Twin. A deliverable could be a report, a prototype, a model, and so on."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DesignActivity
:DesignActivity rdf:type owl:Class ;
                rdfs:subClassOf :DevelopmentActivity ;
                owl:disjointWith :Procurement ;
                rdfs:comment "A DevelopmentActivity, or composition of DevelopmentActivities, that is primarily focussed on design."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DesignInput
:DesignInput rdf:type owl:Class ;
             rdfs:subClassOf :Input ;
             owl:disjointWith :TestingInput ;
             rdfs:comment "Input into some DesignActivity, or primarily design-related input into some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DesignOutput
:DesignOutput rdf:type owl:Class ;
              rdfs:subClassOf :Output ;
              owl:disjointWith :TestingOutput ;
              rdfs:comment "Output from some DesignActivity, or primarily design-related output from some part of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DetailDesign
:DetailDesign rdf:type owl:Class ;
              rdfs:subClassOf :ProductDevelopmentStage ;
              owl:disjointWith :SystemLevelDesign ;
              rdfs:comment "The detail design stage of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity
:DevelopmentActivity rdf:type owl:Class ;
                     owl:disjointWith :Environment ,
                                      :Focus ,
                                      :Input ,
                                      :Output ,
                                      :Parameter ,
                                      :TemporalConstruct ;
                     rdfs:comment """A type of activity undertaken during the design process. 

A DevelopmentActivity can be composed of multiple smaller DevelopmentActivities. Thus it is possible to instantiate a DesignActivity that consists of multiple smaller DesignActivities, but also some TestingActivities, Procurement, and so on."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentEnvironment
:DevelopmentEnvironment rdf:type owl:Class ;
                        rdfs:subClassOf :Environment .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalEntity
:DigitalEntity rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :DigitalEntity
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :isDigitalEntityOf ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :DigitalTwin
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :twinnedPhysicallyWith ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :PhysicalEntity
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :DigitalTwin ;
               owl:disjointWith :PhysicalEntity ;
               rdfs:comment "The digital part of the Twin that is being developed throughout the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalTwin
:DigitalTwin rdf:type owl:Class ;
             rdfs:subClassOf :Artefact ;
             rdfs:comment "A DigitalTwin is that which is being developed at every stage, and during every activity, of the development process."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Document
:Document rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Document
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasURI ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:anyURI
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :Parameter ;
          rdfs:comment """A single link to a document that is a Parameter to the development process.

A Document can be part of a Dataset."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#EngineeringDesign
:EngineeringDesign rdf:type owl:Class ;
                   rdfs:subClassOf :DesignActivity ;
                   rdfs:comment "A DesignActivity, or composition of DesignActivities, that is primarily focussed on engineering design."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment
:Environment rdf:type owl:Class ;
             owl:disjointWith :Focus ,
                              :TemporalConstruct .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow
:Flow rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasDevelopmentActivity ;
                                                   owl:someValuesFrom :DevelopmentActivity
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :duringTemporalPartition ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :TemporalPartition
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :endsWith ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :Step
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :startsWith ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :Step
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :TimeStructure ;
      owl:disjointWith :Span ,
                       :Step ;
      rdfs:comment """A Flow is an ordered list of one or more Steps from one DevelopmentActivity to another, during one TemporalPartition of the development process. 

Flows that occur more than once during the development process can be defined as subclasses. The existing subclasses are not exhaustive."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_CAE_VirtualTesting_PhysicalTesting
:Flow_CAE_VirtualTesting_PhysicalTesting rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasDevelopmentActivity ;
                                                                                      owl:someValuesFrom :CAE_VirtualTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasDevelopmentActivity ;
                                                                                      owl:someValuesFrom :MechanicalTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasDevelopmentActivity ;
                                                                                      owl:someValuesFrom :PerformanceTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasStep ;
                                                                                      owl:someValuesFrom :Step_CAE_VirtualTestingToPerformanceTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasStep ;
                                                                                      owl:someValuesFrom :Step_PerformanceTestingToMechanicalTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :endsWith ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :Step_PerformanceTestingToMechanicalTesting
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :startsWith ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass :Step_CAE_VirtualTestingToPerformanceTesting
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :Flow ;
                                         rdfs:comment """A flow that steps from CAE/virtual testing to performance testing to mechanical testing.

The CAE/virtual testing may be conducted in parallel with the physical testing."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_CAE_VirtualTesting_Procurement
:Flow_CAE_VirtualTesting_Procurement rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                  owl:someValuesFrom :CAE_VirtualTesting
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :hasDevelopmentActivity ;
                                                                                  owl:someValuesFrom :Procurement
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :hasStep ;
                                                                                  owl:someValuesFrom :Step_CAE_VirtualTestingToProcurement
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :endsWith ;
                                                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                  owl:onClass :Step_CAE_VirtualTestingToProcurement
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :startsWith ;
                                                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                  owl:onClass :Step_CAE_VirtualTestingToProcurement
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf :Flow ;
                                     rdfs:comment """A flow that steps from CAE/virtual testing to procurement.

During this Flow, specifications may be sent to suppliers."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_DesignActivity_CAE_VirtualTesting
:Flow_DesignActivity_CAE_VirtualTesting rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasDevelopmentActivity ;
                                                                                     owl:someValuesFrom :CAE_VirtualTesting
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasDevelopmentActivity ;
                                                                                     owl:someValuesFrom :DesignActivity
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasStep ;
                                                                                     owl:someValuesFrom :Step_CAE_VirtualTestingToDesignActivity
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :hasStep ;
                                                                                     owl:someValuesFrom :Step_DesignActivityToCAE_VirtualTesting
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :endsWith ;
                                                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                     owl:onClass :Step_CAE_VirtualTestingToDesignActivity
                                                                                   ]
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty :startsWith ;
                                                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                     owl:onClass :Step_DesignActivityToCAE_VirtualTesting
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf :Flow ;
                                        rdfs:comment """A flow that steps from design activity to CAE/virtual testing and back again.

Often takes the form of a Loop."""@en ;
                                        rdfs:label "Design and analysis using CAE simulation."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_DesignActivity_Procurement
:Flow_DesignActivity_Procurement rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasDevelopmentActivity ;
                                                                              owl:someValuesFrom :DesignActivity
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasDevelopmentActivity ;
                                                                              owl:someValuesFrom :Procurement
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasStep ;
                                                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                              owl:onClass :Step_DesignActivityToProcurement
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :endsWith ;
                                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                              owl:onClass :Step_DesignActivityToProcurement
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :startsWith ;
                                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                              owl:onClass :Step_DesignActivityToProcurement
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf :Flow ;
                                 rdfs:comment """A flow that steps from design activity to procurement.

This release process occurs progressively with a view to ensuring that suppliers of test prototypes are working with design information which is up-to-date but do not need to wait until the respective design activity is finalised."""@en ;
                                 rdfs:label "Design progressively released."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_PhysicalTesting_VirtualTesting_DesignActivity
:Flow_PhysicalTesting_VirtualTesting_DesignActivity rdf:type owl:Class ;
                                                    owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                                               [ rdf:type owl:Class ;
                                                                                                 owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :CAE_VirtualTesting
                                                                                                                                      ]
                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :DesignActivity
                                                                                                                                      ]
                                                                                                                                    ) ;
                                                                                                                 rdf:type owl:Class
                                                                                                               ]
                                                                                                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :CAE_VirtualTesting
                                                                                                                                      ]
                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :MechanicalTesting
                                                                                                                                      ]
                                                                                                                                    ) ;
                                                                                                                 rdf:type owl:Class
                                                                                                               ]
                                                                                                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :DesignActivity
                                                                                                                                      ]
                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty :hasDevelopmentActivity ;
                                                                                                                                        owl:someValuesFrom :PerformanceTesting
                                                                                                                                      ]
                                                                                                                                    ) ;
                                                                                                                 rdf:type owl:Class
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :hasDevelopmentActivity ;
                                                                                                                 owl:someValuesFrom :CAE_VirtualTesting
                                                                                                               ]
                                                                                                             )
                                                                                               ]
                                                                                               [ rdf:type owl:Class ;
                                                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :hasStep ;
                                                                                                                 owl:someValuesFrom :Step_CAE_VirtualTestingToDesignActivity
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :hasStep ;
                                                                                                                 owl:someValuesFrom :Step_MechanicalTestingToCAE_VirtualTesting
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :hasStep ;
                                                                                                                 owl:someValuesFrom :Step_PerformanceTestingToDesignActivity
                                                                                                               ]
                                                                                                             )
                                                                                               ]
                                                                                               [ rdf:type owl:Class ;
                                                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :endsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_CAE_VirtualTestingToDesignActivity
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :endsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_MechanicalTestingToCAE_VirtualTesting
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :endsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_PerformanceTestingToDesignActivity
                                                                                                               ]
                                                                                                             )
                                                                                               ]
                                                                                               [ rdf:type owl:Class ;
                                                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :startsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_CAE_VirtualTestingToDesignActivity
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :startsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_MechanicalTestingToCAE_VirtualTesting
                                                                                                               ]
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :startsWith ;
                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                 owl:onClass :Step_PerformanceTestingToDesignActivity
                                                                                                               ]
                                                                                                             )
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ] ;
                                                    rdfs:subClassOf :Flow ;
                                                    rdfs:comment """A Flow that steps from physical (mechanical and performance) and virtual testing to design activity.

Each procured prototype can involve a mix of old and new parts depending on the project progress. Performance testing starts slightly before mechanical testing and runs almost in parallel. Any design issues identified through these physical tests are dealt with in the next stage of the process."""@en ;
                                                    rdfs:label "Parts progressively incorporated."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow_Procurement_PhysicalTesting
:Flow_Procurement_PhysicalTesting rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( :Flow
                                                                             [ rdf:type owl:Class ;
                                                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty :startsWith ;
                                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                               owl:onClass :Step_ProcurementToMechanicalTesting
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty :startsWith ;
                                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                               owl:onClass :Step_ProcurementToPerformanceTesting
                                                                                             ]
                                                                                           )
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasDevelopmentActivity ;
                                                                               owl:someValuesFrom :MechanicalTesting
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasDevelopmentActivity ;
                                                                               owl:someValuesFrom :PerformanceTesting
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasDevelopmentActivity ;
                                                                               owl:someValuesFrom :Procurement
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasStep ;
                                                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :Step_PerformanceTestingToMechanicalTesting
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasStep ;
                                                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :Step_ProcurementToMechanicalTesting
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasStep ;
                                                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :Step_ProcurementToPerformanceTesting
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :endsWith ;
                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                               owl:onClass :Step_PerformanceTestingToMechanicalTesting
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf :Flow ;
                                  rdfs:comment "A Flow that steps from procurement to physical (performance and mechanical) testing."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Focus
:Focus rdf:type owl:Class ;
       owl:disjointWith :Input ,
                        :Output ,
                        :Parameter ,
                        :TemporalConstruct ;
       rdfs:comment "What you focus on during an activity, or time period, or in relation to something."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Gateway
:Gateway rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Gateway
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :closesStage ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass :ProductDevelopmentStage
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :opensStage ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass :ProductDevelopmentStage
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf :TemporalPartition ;
         owl:disjointWith :ProductDevelopmentStage ;
         rdfs:comment "In a stage-gate process, a Gateway closes one ProductDevelopmentStage and opens another, given that certain conditions are met."@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Input
:Input rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :Input
                                                  [ rdf:type owl:Class ;
                                                    owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty :hasArtefact ;
                                                                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                           owl:onClass :Artefact
                                                                                                         ]
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty :hasComponent ;
                                                                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                           owl:onClass :Component
                                                                                                         ]
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty :hasParameter ;
                                                                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                           owl:onClass :Parameter
                                                                                                         ]
                                                                                                       )
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty :inputInto ;
                                                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                           owl:onClass [ rdf:type owl:Class ;
                                                                                                         owl:unionOf ( :DevelopmentActivity
                                                                                                                       :TemporalConstruct
                                                                                                                     )
                                                                                                       ]
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasEnvironment ;
                                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                    owl:onClass :Environment
                                                                  ]
                                                                )
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       owl:disjointWith :Output ,
                        :TemporalConstruct ;
       rdfs:comment """An Input consists of the things that are necessary in order to begin a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact. Supposing we have a Twin as the Output from one DevelopmentActivity. In order to continue developing the Twin during the next DevelopmentActivity, it will have to be passed in as part of the Input to that DevelopmentActivity.

An item of information, such as a Datapoint, may also form part of the Input. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration
:Iteration rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :Iteration
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :duringTemporalPartition ;
                                                        owl:someValuesFrom :TemporalPartition
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :hasDevelopmentActivity ;
                                                        owl:someValuesFrom :DevelopmentActivity
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isRepeated ;
                                                        owl:hasValue "true"^^xsd:boolean
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :TimeStructure ;
           owl:disjointWith :Span ,
                            :Step ;
           rdfs:comment """An Iteration groups DevelopmentActivities that are carried out together in cycles that may be repeated. 

Iterations that occur more than once during the development process may be defined as subclasses. The existing subclasses are not exhaustive.

The DevelopmentActivities in an Iteration are not assumed to be carried out in sequence or in any particular order."""@en .


###  http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_EngineeringDesign
:Iteration_CAE_VirtualTesting_EngineeringDesign rdf:type owl:Class ;
                                                owl:equivalentClass [ owl:intersectionOf ( :Iteration
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty :hasDevelopmentActivity ;
                                                                                             owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                                 owl:unionOf ( :CAE_VirtualTesting
                                                                                                                               :EngineeringDesign
                                                                                                                             )
                                                                                                               ]
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty :hasDevelopmentActivity ;
                                                                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                             owl:onClass :CAE_VirtualTesting
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty :hasDevelopmentActivity ;
                                                                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                             owl:onClass :EngineeringDesign
                                                                                           ]
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ] ;
                                                rdfs:subClassOf :Iteration ;
                                                rdfs:comment "An Iteration that includes CAE/virtual testing and engineering design."@en .


