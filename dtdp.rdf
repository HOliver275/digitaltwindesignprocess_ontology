        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#measuredValue"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minCycles -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minCycles">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minTargetValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#minTargetValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint"/>
        <rdfs:comment>Minimum target value of a Datapoint. Can be any data type.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#numCycles -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#numCycles">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint"/>
        <rdfs:comment xml:lang="en">Previous value of a Datapoint. Can be any data type.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValuePhysical -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValuePhysical">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValueVirtual"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValueVirtual -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValueVirtual">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#prevMeasuredValue"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#updatedOn -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#updatedOn">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">Date/time stamp recording when an entity was updated.</rdfs:comment>
    </owl:DatatypeProperty>
    


