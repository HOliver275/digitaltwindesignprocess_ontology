                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#EngineeringDesign"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <rdfs:comment xml:lang="en">An Iteration that includes CAE/virtual testing, engineering design, mechanical testing, and performance testing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration_CAE_VirtualTesting_PerformanceTesting_MechanicalTesting">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <rdfs:comment>An Iteration that involves CAE/virtual testing, mechanical testing, and performance testing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Loop -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Loop">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Loop"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasStep"/>
                        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isRepeated"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow"/>
        <rdfs:comment xml:lang="en">A Loop is a Flow that may be repeated. 

Unlike an Iteration which is not necessarily ordered, a Loop has an ordered sequence of Steps.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#MechanicalTesting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
        <rdfs:comment xml:lang="en">A Model is a representation of something that exists in reality. An architectural model can be a physical or digital representation of a building. An information model is a digital representation of some knowledge domain (this ontology is an information model).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Modelling -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Modelling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation"/>
        <rdfs:comment xml:lang="en">A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on modelling.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Analysis"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement"/>
        <rdfs:comment xml:lang="en">A DevelopmentActivity that consists of modelling and/or simulation, or a composition of DevelopmentActivities, that is primarily focussed on modelling and/or simulation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact"/>
                                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                                <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasComponent"/>
                                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                                <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasParameter"/>
                                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                                <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
                                            </owl:Restriction>
                                        </owl:unionOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#outputFrom"/>
                                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                        <owl:onClass>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                                                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:onClass>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasEnvironment"/>
                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
        <rdfs:comment xml:lang="en">&quot;An Output consists of the things that are produced or changed during a particular DevelopmentActivity or TemporalConstruct in the development process.

For example, a Twin is an Artefact that is developed during some DevelopmentActivity. It is then part of the Output from that DevelopmentActivity, and will most likely form part of the Input to another DevelopmentActivity. 

An item of information, such as a Datapoint, may also form part of an Output. For example, we may need to track the weight in kg of a Component through the development process. This would be done using the same Datapoint included into the Input into a DevelopmentActivity, which then becomes part of the Output from that same activity.&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
        <rdfs:comment xml:lang="en">A Parameter is an item of information that forms part of the Input to, or Output from, some DevelopmentActivity or TemporalConstruct in the development process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PerformanceTesting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalDevelopmentEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalDevelopmentEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentEnvironment"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualDevelopmentEnvironment"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalEntity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isPhysicalEntityOf"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalTwin"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#twinnedDigitallyWith"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalEntity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
        <rdfs:comment xml:lang="en">The physical part of the product being developed throughout the development process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalModel -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDescription"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualModel"/>
        <rdfs:comment xml:lang="en">A physical model will not fit in an ontology, so must be accompanied by at least one text description.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTestEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTestEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestEnvironment"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#PhysicalTesting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualTesting"/>
        <rdfs:comment xml:lang="en">Testing of objects in the physical world.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingActivity"/>
        <rdfs:comment xml:lang="en">A DevelopmentActivity, or composition of DevelopmentActivities, that primarily involves procurement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Product -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Product">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Product"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalTwin"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
        <rdfs:comment xml:lang="en">The thing that is produced - and may or may not be sold, depending on the context - as the culmination of the development process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasNext"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasPrevious"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
        <rdfs:comment xml:lang="en">In this ontology, we assume that a ProductDevelopmentStage is part of a stage-gate process, but the ontology should be extensible to accommodate other development process models.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProgressiveRelease -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProgressiveRelease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity"/>
        <rdfs:comment xml:lang="en">A ReleaseActivity that is carried out progressively over some TemporalConstruct.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ReleaseActivity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasOutput"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <rdfs:comment xml:lang="en">A DevelopmentActivity, or composition of DevelopmentActivities, that relates mainly to the release of some deliverable.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Shadow -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Shadow">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualModel"/>
        <rdfs:comment>A Shadow is more evolved (closer to meeting the required conditions after physical and virtual testing) than a model.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Simulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Simulation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Simulation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasURI"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
        <rdfs:comment xml:lang="en">A simulation of some real-world object or process; or, the output from a SimulationActivity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SimulationActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SimulationActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ModellingAndSimulation"/>
        <rdfs:comment xml:lang="en">A ModellingAndSimulation activity, or a composition of ModellingAndSimulation activities, that is primarily focussed on simulation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#duringTemporalPartition"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#spansFrom"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#spansTo"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
        <rdfs:comment xml:lang="en">A Span links two DevelopmentActivities across one or more TemporalPartitions.

Spans can be sequentially linked, using the followsFrom and leadsTo properties, to form a Continuity across TemporalPartitions of the development process.

A Span differs from a Step in that a Span is part of a Continuity, which begins and ends in two different TemporalPartitions. Therefore the TemporalPartitions of a Span must be specified as part of the Span&apos;s definition.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#stepFrom"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#stepTo"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasNext"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasPrevious"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isOptional"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
        <rdfs:comment xml:lang="en">A Step connects one DevelopmentActivity to another.

Steps can be sequentially linked, using the hasPrevious and hasNext properties, to form a Flow.

A Step forms part of a Flow, which takes place within exactly one TemporalPartition. A Step differs from a Span in that the DevelopmentActivities connected by a Step always begin in the same TemporalPartition. The TemporalPartition is the same as the one specified in the Flow, so does not have to be specified at each Step of the Flow.</rdfs:comment>
    </owl:Class>
    


