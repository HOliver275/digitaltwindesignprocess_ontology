                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#EngineeringDesign"/>
