                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Deliverable"/>
        <rdfs:comment xml:lang="en">The Deliverable of some DevelopmentActivity or TemporalConstruct.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isDevelopmentActivityOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <rdfs:comment xml:lang="en">The DevelopmentActivity associated with some part of the development process.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDigitalEntity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDigitalEntity">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isDigitalEntityOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalTwin"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DigitalEntity"/>
        <rdfs:comment xml:lang="en">A PhysicalEntity has a DigitalEntity. To associate the DigitalEntity with some other entity, use hasArtefact.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasEnvironment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasEnvironment">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isEnvironmentOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasExpectedValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasExpectedValue">
