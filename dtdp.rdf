        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isArtefactOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Input"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
        <rdfs:comment xml:lang="en">Artefact associated with a DevelopmentActivity or TemporalConstruct.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasComponent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isComponentOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Input"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component"/>
        <rdfs:comment xml:lang="en">Component associated with a DevelopmentActivity or TemporalConstruct or Input or Output</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasCycle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasCycle">
