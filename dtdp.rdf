        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Cycle"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDeliverable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDeliverable">
