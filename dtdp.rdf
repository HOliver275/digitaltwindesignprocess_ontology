     -->

    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Analysis -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Analysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Procurement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasArtefact"/>
                                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Artefact"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasComponent"/>
                                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasParameter"/>
                                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Focus"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
        <rdfs:comment xml:lang="en">An identifiable work involved in some stage or activity of the development process that:
- is disseminated or delivered as one of the intermediate or finalized results of the process; and/or
-is input into some part of the development process as an object to be analyzed, developed or tested; and
-is not merely a transitory work or information scrap that is revised, discarded or abandoned throughout the process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CADModel -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CADModel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualModel"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#CAE_VirtualTesting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#VirtualTesting"/>
        <rdfs:comment xml:lang="en">Computer-Aided Engineering (CAE) virtual testing</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Comparison -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Comparison">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Comparison"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasParameter"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Analysis"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Component">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Focus"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
        <rdfs:comment xml:lang="en">A part of some whole. Could be a code module of the software which itself is a component of the DigitalTwin; or could be a part of the PhysicalAsset.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ConceptDevelopment -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ConceptDevelopment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DetailDesign"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#SystemLevelDesign"/>
        <rdfs:comment xml:lang="en">The concept development stage of the development process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasSpan"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#duringTemporalPartition"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityFrom"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityTo"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#endsWith"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#startsWith"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Cycle"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
        <rdfs:comment xml:lang="en">A Continuity consists of a sequence of one or more Spans, that link two or more DevelopmentActivities, across two or more TemporalPartitions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Cycle -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Cycle">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Cycle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDevelopmentActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isRepeated"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Iteration"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Span"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step"/>
        <rdfs:comment xml:lang="en">A Cycle is one repetition of an Iteration.

 A loose assumption is that each Cycle of an Iteration is an exact repetition of the previous Cycle, but this assumption is not formalized by any conditions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Datapoint"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#createdOn"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#expectedValue"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange>
                            <rdfs:Datatype>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#XMLLiteral"/>
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NCName"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#Name"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#anyURI"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#byte"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#decimal"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#double"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#float"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#int"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#language"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#long"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#negativeInteger"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#nonPositiveInteger"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#normalizedString"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#short"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#token"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#rational"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#real"/>
                                </owl:unionOf>
                            </rdfs:Datatype>
                        </owl:onDataRange>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasUnit"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#maxTargetValue"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onDataRange>
                            <rdfs:Datatype>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#XMLLiteral"/>
                                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NCName"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#Name"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#anyURI"/>
                                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
