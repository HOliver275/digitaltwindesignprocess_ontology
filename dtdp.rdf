                        <owl:onClass rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Step_DesignActivityToProcurement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow"/>
        <rdfs:comment xml:lang="en">A flow that steps from design activity to procurement.

This release process occurs progressively with a view to ensuring that suppliers of test prototypes are working with design information which is up-to-date but do not need to wait until the respective design activity is finalised.</rdfs:comment>
        <rdfs:label xml:lang="en">Design progressively released.</rdfs:label>
    </owl:Class>
    


