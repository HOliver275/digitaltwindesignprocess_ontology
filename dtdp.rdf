    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#2DModel"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasDescription"/>
                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasURI"/>
                                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Model"/>
        <rdfs:comment>A 2D model can be physical or virtual. At minimum, it must have either a description providing the minimum useful information (such as where the physical 2D model can be found), or the URI where the virtual model can be found.</rdfs:comment>
    </owl:Class>
    


