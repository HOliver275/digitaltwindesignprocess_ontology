                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
        <rdfs:comment xml:lang="en">A single link to a document that is a Parameter to the development process.

A Document can be part of a Dataset.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#EngineeringDesign -->

