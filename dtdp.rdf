    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasModel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#hasModel">
