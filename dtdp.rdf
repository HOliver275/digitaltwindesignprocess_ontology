    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Environment">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Focus"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow -->

    <owl:Class rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Flow">
