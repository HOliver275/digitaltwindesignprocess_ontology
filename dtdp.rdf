<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#"
     xml:base="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:figure8secondattempt="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closedByGateway -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closedByGateway">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closesStage"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Gateway"/>
        <rdfs:comment xml:lang="en">In a stage-gate development process, a ProductDevelopmentStage is closed by a Gateway, provided certain conditions are met.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closesStage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#closesStage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Gateway"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ProductDevelopmentStage"/>
        <rdfs:comment xml:lang="en">A Gateway closes a ProductDevelopmentStage in a stage-gate development process.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesAfter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesAfter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesBefore"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Anything that must be preceded by some other thing or things at some point in the development process.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesBefore -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#comesBefore">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Anything that must precede some other thing or things at some point in the development process.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#compareTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#compareTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Parameter"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#toContinuity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
        <rdfs:comment xml:lang="en">The TemporalPartition where a Continuity begins.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#continuityTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#fromContinuity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
        <rdfs:comment xml:lang="en">The TemporalPartition where a Continuity ends.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#duringTemporalPartition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#duringTemporalPartition">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#temporalPartitionIncludes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
        <rdfs:comment xml:lang="en">A DevelopmentActivity, or a TemporalConstruct that is not itself a TemporalPartition, takes place during a TemporalPartition in the development process.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#endsWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#endsWith">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isEndOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TimeStructure"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The DevelopmentActivity or TemporalConstruct at the end of a TimeStructure.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#failLeadsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#failLeadsTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#ledToByFailureOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TestingActivity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#followsFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#followsFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#isFollowedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Input"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Output"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#DevelopmentActivity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalConstruct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">One DevelopmentActivity or TemporalConstruct leads to another, sometimes.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#fromContinuity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#fromContinuity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#TemporalPartition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#Continuity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/helenoliver/ontologies/2026/2/figure8secondattempt#fromSpan -->

